.page{padding:28rpx 24rpx 80rpx}.hero,.form,.catalog{padding:26rpx;margin-bottom:18rpx}.title{font-size:38rpx;font-weight:900}.muted{color:#6b6370;font-size:23rpx;line-height:1.55;margin-top:8rpx}.sync{font-size:21rpx;color:#8a828e;margin-top:14rpx}.sync.ok{color:#0c7156}.form{display:flex;flex-direction:column;gap:16rpx}.input{box-sizing:border-box;width:100%;height:88rpx;background:#f1f0f2;border-radius:14rpx;padding:0 20rpx;font-size:27rpx}.textarea{box-sizing:border-box;width:100%;min-height:220rpx;background:#f1f0f2;border-radius:14rpx;padding:20rpx;font-size:27rpx;line-height:1.55}.actions{display:flex;gap:12rpx;flex-wrap:nowrap}.actions .btn{flex:1;min-width:0;margin:0;white-space:nowrap}.catalog-head{display:flex;justify-content:space-between;align-items:center;font-size:29rpx;font-weight:900;margin-bottom:10rpx}.catalog-head .muted{margin:0;font-weight:400}.catalog-row{display:flex;align-items:center;gap:14rpx;padding:18rpx 0;border-bottom:1rpx solid rgba(28,26,30,.09)}.catalog-row:last-child{border-bottom:0}.catalog-key{width:92rpx;font-weight:900;color:#ea7428;font-size:24rpx}.catalog-main{flex:1;min-width:0}.catalog-cn{font-size:27rpx;font-weight:800}.catalog-en{font-size:21rpx;color:#7b7380;margin-top:3rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.catalog-count{font-size:21rpx;color:#7b7380;white-space:nowrap}
@import "../../utils/ui/components.wxss";
.form .field-label{font-size:23rpx;color:#6b6370;margin-bottom:-12rpx}.form .input{height:72rpx}.form .textarea{min-height:168rpx}
