<view class="page">
  <view class="hero">
    <view class="kicker">CO-OP GAME BOARD</view>
    <view class="title">联机游戏进度</view>
    <view class="desc">共用进度、车辆分配与游玩顺序。云端是主存档。</view>
  </view>
  <view class="games">
    <view wx:for="{{games}}" wx:key="key" class="ui-card game card {{item.enabled ? '' : 'disabled'}}" bindtap="openGame" data-key="{{item.key}}">
      <view>
        <view class="game-name">{{item.name}}</view>
        <view class="game-sub">{{item.subtitle}}</view>
      </view>
      <image wx:if="{{item.enabled}}" class="arrow" src="/assets/icons/chevron-right.svg"/><text wx:else="" class="disabled-label">预留</text>
    </view>
  </view>
</view>