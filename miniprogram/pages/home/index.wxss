.page{padding:44rpx 30rpx 80rpx}.hero{background:#1c1a1e;color:white;border-radius:26rpx;padding:42rpx 34rpx;margin-bottom:28rpx;position:relative;overflow:hidden}.hero::after{content:"";position:absolute;width:280rpx;height:280rpx;border:40rpx solid rgba(255,255,255,.035);border-radius:50%;right:-90rpx;top:-110rpx}.kicker{font-size:20rpx;letter-spacing:4rpx;color:#ea7428;font-weight:700}.title{font-size:52rpx;font-weight:800;margin-top:12rpx}.desc{font-size:25rpx;color:rgba(255,255,255,.64);margin-top:14rpx}.games{display:flex;flex-direction:column;gap:18rpx}.game{padding:30rpx 30rpx;display:flex;align-items:center;justify-content:space-between}.game-name{font-size:36rpx;font-weight:800}.game-sub{font-size:24rpx;color:#6b6370;margin-top:8rpx}.arrow{font-size:40rpx;font-weight:700;color:#ea7428}.disabled{opacity:.55}.disabled .arrow{font-size:22rpx;color:#6b6370}
@import "../../utils/ui/components.wxss";
