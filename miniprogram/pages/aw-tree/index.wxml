<view class="aw-page"><view class="hero"><view class="eyebrow">ARMORED WARFARE · UNLOCK ROUTE</view><view class="title">科技树与获取条件</view><view class="subtitle">车辆资料库与车队共用</view></view>
  <button wx:if="{{historyCount}}" class="ui-button ui-compact ghost small" bindtap="back">‹ 返回上一个车辆与浏览位置</button>
  <input class="ui-field" placeholder="搜索并定位车辆" value="{{query}}" bindinput="search"/>
  <view wx:if="{{vehicle}}" class="tree-route"><view class="ui-card vehicle-card"><view class="vehicle-heading"><view class="vehicle-open" bindtap="detail"><aw-vehicle-label vehicle-id="{{vehicle.id}}" catalog-revision="{{catalogRevision}}"/></view><text class="vehicle-chevron">›</text></view>
    <view class="row"><button class="ui-button {{prerequisite.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><text class="{{prerequisite.needsPrerequisite ? 'prerequisite-dot' : ''}}">{{prerequisite.needsPrerequisite ? '!' : '前置配置'}}</text></button><text wx:if="{{prerequisite.needsPrerequisite}}" class="muted">需要前置</text><text wx:if="{{prerequisite.customPrerequisite}}" class="custom-prerequisite">自定义前置</text></view></view>
    <block wx:if="{{configured && route.nodes.length > 1}}"><view class="label">当前玩家配置的前置 · 前置在前</view><view wx:for="{{route.nodes}}" wx:key="vehicleId" class="ui-card vehicle-card" data-id="{{item.vehicleId}}" bindtap="select"><view class="vehicle-heading"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.vehicle.name}}" catalog-revision="{{catalogRevision}}"/></view><text class="vehicle-chevron">›</text></view><view class="vehicle-caption">{{item.owned ? '已拥有' : '待获取'}}</view></view></block>
    <view class="label">科技树显示关系</view><view class="muted">点击车辆查看；通过感叹号配置当前玩家的前置。</view><view wx:for="{{related}}" wx:key="id" class="ui-card vehicle-card" data-id="{{item.id}}" bindtap="select"><view class="vehicle-caption">{{item.direction}}</view><view class="vehicle-heading"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.id}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><text class="vehicle-chevron">›</text></view></view>
  </view>
  <view class="label">共 {{count}} 辆 · {{query ? '搜索结果' : '选择车辆'}}</view><view wx:for="{{candidates}}" wx:key="id" class="ui-card vehicle-card vehicle-heading" data-id="{{item.id}}" bindtap="select"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.id}}" catalog-revision="{{catalogRevision}}"/></view><text class="vehicle-chevron">›</text></view><view wx:if="{{!candidates.length}}" class="empty">没有匹配的车辆</view>
  <button wx:if="{{count > candidates.length}}" bindtap="loadMore" class="ui-button ghost">加载更多车辆（{{candidates.length}} / {{count}}）</button>
</view>

<aw-prerequisites wx:if="{{prerequisiteForm}}" vehicle-id="{{prerequisiteForm.vehicleId}}" member-id="{{prerequisiteForm.memberId}}" bind:saved="prerequisitesSaved" bind:cancel="closePrerequisites"/>
