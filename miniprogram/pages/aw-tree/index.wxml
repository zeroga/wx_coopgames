<view class="aw-page"><view class="hero"><view class="eyebrow">ARMORED WARFARE · UNLOCK ROUTE</view><view class="title">科技树与获取条件</view><view class="subtitle">车辆资料库与车队共用</view></view>
  <button wx:if="{{historyCount}}" class="ghost small" bindtap="back">‹ 返回上一个车辆与浏览位置</button>
  <input placeholder="搜索并定位车辆" value="{{query}}" bindinput="search"/>
  <view wx:if="{{vehicle}}" class="card"><view class="row between"><text class="card-title">{{vehicle.displayName}}</text><text class="link" bindtap="detail">车辆详情 ›</text></view>
    <view class="row"><button class="{{prerequisite.needsPrerequisite ? 'prerequisite-alert' : 'ghost small'}}" bindtap="configurePrerequisites">{{prerequisite.needsPrerequisite ? '!' : '前置配置'}}</button><text wx:if="{{prerequisite.needsPrerequisite}}" class="muted">需要前置</text><text wx:if="{{prerequisite.customPrerequisite}}" class="custom-prerequisite">自定义前置</text></view>
    <block wx:if="{{configured && route.nodes.length > 1}}"><view class="label">当前玩家配置的前置 · 前置在前</view><view wx:for="{{route.nodes}}" wx:key="vehicleId" class="line" data-id="{{item.vehicleId}}" bindtap="select">{{item.owned ? '✓' : '○'}} {{item.vehicle.name}} <text class="muted">{{item.owned ? '已拥有' : '待获取'}} ›</text></view></block>
    <view class="label">科技树显示关系</view><view class="muted">点击车辆查看；通过感叹号配置当前玩家的前置。</view><view wx:for="{{related}}" wx:key="id" class="line" data-id="{{item.id}}" bindtap="select"><view class="link">{{item.direction}} · {{item.name}} ›</view></view>
  </view>
  <view class="label">共 {{count}} 辆 · {{query ? '搜索结果' : '选择车辆'}}</view><view wx:for="{{candidates}}" wx:key="id" class="line row between" data-id="{{item.id}}" bindtap="select"><text>{{item.displayName}}</text><text class="muted">T{{item.tier}} · {{item.vehicle_class}} ›</text></view><view wx:if="{{!candidates.length}}" class="empty">没有匹配的车辆</view>
  <button wx:if="{{count > candidates.length}}" class="ghost" bindtap="loadMore">加载更多车辆（{{candidates.length}} / {{count}}）</button>
</view>

<aw-prerequisites wx:if="{{prerequisiteForm}}" vehicle-id="{{prerequisiteForm.vehicleId}}" member-id="{{prerequisiteForm.memberId}}" bind:saved="prerequisitesSaved" bind:cancel="closePrerequisites"/>
