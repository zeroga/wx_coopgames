@import "../../utils/aw/theme.wxss";

@import "../../utils/ui/components.wxss";
.tree-tools { display:flex; flex-direction:column; gap:12rpx; }
.tree-route .label { margin-top:14rpx; }
.tree-route .vehicle-card:first-child { margin-top:0; }
.tree-route .vehicle-card:last-child { margin-bottom:0; }
.tree-route .vehicle-card { box-shadow:none; }
.results-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; }
.load-card .ui-button { width:100%; }
.vehicle-grid { display:flex; flex-wrap:wrap; gap:18rpx; }
.vehicle-grid > .vehicle-card { flex:1 1 320px; min-width:0; margin:0; }
