/* Preserve the existing SnowRunner faces inside non-overlapping touch slots. */
.step-head { flex-wrap:nowrap; }
.step-title-wrap { min-width:0; }
.head-actions { gap:26rpx; margin-left:auto; }
.head-actions .ui-icon-touch { font-size:30rpx; }
.sr-option { margin:0; }
.segment { align-items:center; }
.seg { box-sizing:border-box; text-align:center; }
.assign { margin-left:47rpx; flex-wrap:wrap; }
.assign-btn { box-sizing:border-box; text-align:center; }
@import "../../utils/ui/components.wxss";
.sr-option { margin:0; }
.summary-box{box-sizing:border-box}
.check-icon { display:block; width:24rpx; height:24rpx; }
.complete-expand { display:inline-flex; align-items:center; gap:4rpx; }
.inline-chevron { display:block; width:24rpx; height:24rpx; }
.vehicle { padding:13rpx 0; }
.page { box-sizing:border-box; width:100%; max-width:1000px; margin:0 auto; }
.columns { display:flex; flex-wrap:wrap; gap:24rpx; }
.columns .col { flex:1 1 320px; min-width:0; }
.columns .col+.col { margin-top:0; }
.join-input,.name-input,.row-input,.note { background:#f6f4f7; }
.join-input:focus,.name-input:focus,.row-input:focus,.note:focus { box-shadow:inset 0 0 0 1rpx #ea7428; }
