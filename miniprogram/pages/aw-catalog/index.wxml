<view class="aw-page">
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · VEHICLES</view><view class="title">车辆资料库</view><view class="subtitle">查车辆、比配置、安排车队职责</view></view>
  <view class="nav"><button class="active">车辆资料库</button><button data-page="fleet" bindtap="nav">车队管理</button></view>
  <view class="search-row"><input placeholder="搜索车辆名称" value="{{filters.query}}" data-key="query" bindinput="input"/><button class="ghost small" data-tab="base" bindtap="showFilters">筛选{{selected.length ? ' · ' + selected.length : ''}} ▾</button></view>
  <view class="filters"><text wx:for="{{selected}}" wx:key="name" class="tag selected" data-key="{{item.key}}" data-value="{{item.value}}" bindtap="remove">{{item.name}} ×</text><text wx:if="{{selected.length}}" class="link" bindtap="clear">重置</text></view>
  <view class="row between result-meta"><text class="muted">找到 {{count}} 辆车辆</text><text class="link" bindtap="refreshCloud">{{loading ? '刷新中…' : '刷新云端资料'}}</text></view>
  <view wx:if="{{error}}" class="warning">{{error}}</view>
  <view wx:for="{{results}}" wx:key="id" class="card vehicle-card" data-id="{{item.id}}" bindtap="open">
    <view class="row between"><text class="vehicle-name">{{item.displayName}}</text><text class="tag">{{item.is_legendary ? '传奇' : 'T' + item.tier}} · {{item.vehicle_class}}</text></view>
    <view><text wx:for="{{item.caps}}" wx:key="*this" class="tag">{{item}}</text></view>
    <view wx:if="{{item.performance}}" class="muted">{{item.performance}}</view><view wx:if="{{item.ammoSummary}}" class="line">{{item.ammoSummary}}</view>
    <view wx:for="{{item.team}}" wx:for-item="member" wx:key="id" class="line"><view>{{member.memberName}} · {{member.statusText}}</view><view class="muted">{{member.roleText}}</view><view wx:if="{{member.planText}}" class="muted">{{member.planText}}</view></view>
    <view wx:if="{{item.extra}}" class="link">+{{item.extra}} 条车队记录</view><view class="muted">{{item.quality}}</view>
  </view>
  <view wx:if="{{!results.length}}" class="empty">没有符合条件的车辆。可减少筛选条件；资料未知也会影响命中。</view>
  <view class="muted">{{source}} · 缺少记录不代表没有该能力</view>
  <view wx:if="{{count > results.length}}" class="empty">继续向下滚动加载</view>
</view>

<block wx:if="{{filterTab}}">
  <view class="backdrop" catchtap="closeFilters"></view>
  <view class="sheet"><view class="sheet-head"><view class="card-title">筛选车辆</view><button class="ghost small" bindtap="closeFilters">收起</button></view>
    <scroll-view scroll-x="{{true}}" class="filter-scroll"><text wx:for="{{filterTabs}}" wx:key="key" class="filter-tab {{filterTab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="switchFilters">{{item.name}}</text></scroll-view>
    <scroll-view scroll-y="{{true}}" class="sheet-content">
  <view class="filter-content">
    <block wx:if="{{filterTab === 'base'}}"><view wx:for="{{groups}}" wx:key="key" wx:for-item="group"><view class="label">{{group.name}} · 可多选</view><text wx:for="{{group.options}}" wx:key="value" class="tag {{selection[group.key + ':' + item.value] ? 'selected' : ''}}" data-key="{{group.key}}" data-value="{{item.value}}" bindtap="toggle">{{item.name}}</text></view></block>
    <block wx:if="{{filterTab === 'cap'}}"><view class="row between"><text>出厂即有</text><switch checked="{{filters.factory}}" color="#1c1a1e" bindchange="factory"/></view><view class="muted">关闭时按满配可获得；多个能力同时满足。未知能力不命中。</view><view wx:for="{{capabilityGroups}}" wx:key="name" wx:for-item="group"><view class="label">{{group.name}}</view><text wx:for="{{group.options}}" wx:key="value" class="tag {{selection['capabilities:' + item.value] ? 'selected' : ''}}" data-key="capabilities" data-value="{{item.value}}" bindtap="toggle">{{item.name}}</text></view></block>
    <block wx:if="{{filterTab === 'ammo'}}"><view class="label">弹种 · 可多选</view><text wx:for="{{ammoTypes}}" wx:key="value" class="tag {{selection['ammoTypes:' + item.value] ? 'selected' : ''}}" data-key="ammoTypes" data-value="{{item.value}}" bindtap="toggle">{{item.name}}</text><view class="label">弹药特性 · 同时满足</view><text wx:for="{{ammoTraits}}" wx:key="value" class="tag {{selection['ammoTraits:' + item.value] ? 'selected' : ''}}" data-key="ammoTraits" data-value="{{item.value}}" bindtap="toggle">{{item.name}}</text><view class="label">最高穿深 ≥ mm</view><input type="digit" value="{{filters.penetration}}" data-key="penetration" bindinput="input" placeholder="不限"/><view class="muted">弹种、特性、穿深必须由同一枚弹药满足。</view></block>
    <block wx:if="{{filterTab === 'perf'}}"><view class="label">最高速度 ≥ km/h</view><input type="digit" value="{{filters.speed}}" data-key="speed" bindinput="input" placeholder="不限"/><view class="label">视野 ≥ m</view><input type="digit" value="{{filters.view}}" data-key="view" bindinput="input" placeholder="不限"/><view class="label">隐蔽 ≥ %</view><input type="digit" value="{{filters.camo}}" data-key="camo" bindinput="input" placeholder="不限"/></block>
    <block wx:if="{{filterTab === 'get'}}"><view class="label">获取方式</view><text wx:for="{{acquisitions}}" wx:key="value" class="tag {{selection['acquisition:' + item.value] ? 'selected' : ''}}" data-key="acquisition" data-value="{{item.value}}" bindtap="toggle">{{item.name}}</text><view class="label">Premium</view><picker range="{{booleanOptions}}" value="{{premiumIndex}}" data-key="premium" bindchange="bool"><view class="picker">{{booleanOptions[premiumIndex]}} ▾</view></picker><view class="label">当前可研发</view><picker range="{{booleanOptions}}" value="{{researchIndex}}" data-key="researchable" bindchange="bool"><view class="picker">{{booleanOptions[researchIndex]}} ▾</view></picker></block>
  </view>

    </scroll-view><view class="actions"><button class="ghost" bindtap="clear">重置条件</button><button class="primary" bindtap="closeFilters">查看 {{count}} 辆车辆</button></view>
  </view>
</block>
