<view class="aw-page">
  <view wx:if="{{syncError}}" class="warning">{{syncError}}</view>
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · VEHICLES</view><view class="title">车辆资料库</view><view class="subtitle">查车辆、比配置、安排车队职责</view></view>
  <input class="ui-field search-input" placeholder="搜索车辆名称" value="{{filters.query}}" data-key="query" bindinput="input"/>
  <view class="filter-toolbar"><button class="ui-button ui-compact ghost filter-trigger" data-tab="base" bindtap="showFilters">筛选{{selected.length ? ' · ' + selected.length : ''}} ▾</button><text wx:if="{{selected.length}}" class="link" bindtap="clear">清空筛选</text></view>
  <view wx:if="{{selected.length}}" class="filters"><view class="ui-option-grid"><view wx:for="{{selected}}" wx:key="name" class="ui-option selected" data-key="{{item.key}}" data-value="{{item.value}}" bindtap="remove"><view class="ui-option-face">{{item.name}} ×</view></view></view></view>
  <view class="row between result-meta"><text class="muted">找到 {{count}} 辆车辆</text><text class="muted">资料 {{catalogInfo.versionText}}</text></view>
  <view wx:if="{{catalogInfo.error}}" class="warning">{{catalogInfo.status}} · {{catalogInfo.error}}</view>
  <view wx:if="{{error}}" class="warning">{{error}}</view>
  <view wx:for="{{results}}" wx:key="id" class="ui-card vehicle-card" data-id="{{item.id}}" bindtap="open">
    <view class="vehicle-heading"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.id}}" catalog-revision="{{catalogRevision}}"/></view><text class="vehicle-chevron">›</text></view>
    <view><text wx:for="{{item.caps}}" wx:key="*this" class="tag">{{item}}</text></view>
    <view wx:if="{{item.performance}}" class="muted">{{item.performance}}</view><view wx:if="{{item.ammoSummary}}" class="line">{{item.ammoSummary}}</view>
    <view wx:for="{{item.team}}" wx:for-item="member" wx:key="id" class="line"><view class="row between"><text>{{member.memberName}} · {{member.statusText}}</text><button wx:if="{{member.status === 'planned'}}" class="ui-button {{member.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-vehicle="{{item.id}}" data-member="{{member.memberId}}" catchtap="configurePrerequisites" aria-label="前置与 Token 配置"><text class="{{member.needsPrerequisite ? 'prerequisite-dot' : ''}}">{{member.needsPrerequisite ? '!' : '前置配置'}}</text></button></view><view wx:if="{{member.customPrerequisite}}" class="custom-prerequisite">自定义前置</view><view class="muted">{{member.roleText}}</view><view wx:if="{{member.planText}}" class="muted">{{member.planText}}</view></view>
    <view wx:if="{{item.extra}}" class="link">+{{item.extra}} 条车队记录</view>
  </view>
  <view wx:if="{{!results.length}}" class="empty">没有符合条件的车辆。可减少筛选条件；资料未知也会影响命中。</view>
  <view class="muted">缺少记录不代表没有该能力</view>
  <view wx:if="{{count > results.length}}" class="empty">继续向下滚动加载</view>
</view>

<block wx:if="{{filterTab}}">
  <view class="backdrop" catchtap="closeFilters"></view>
  <view class="sheet"><view class="sheet-head"><view class="card-title">筛选车辆</view><button class="ui-button ui-compact ghost small" bindtap="closeFilters">收起</button></view>
    <view class="filter-scroll"><view wx:for="{{filterTabs}}" wx:key="key" class="ui-tab filter-tab {{filterTab === item.key ? 'active' : ''}}" data-tab="{{item.key}}" bindtap="switchFilters">{{item.name}}</view></view>
    <scroll-view scroll-y="{{true}}" class="sheet-content">
  <view class="filter-content">
    <block wx:if="{{filterTab === 'base'}}"><view wx:for="{{groups}}" wx:key="key" wx:for-item="group"><view class="label">{{group.name}} · 可多选</view><view class="ui-option-grid"><view wx:for="{{group.options}}" wx:key="value" class="ui-option {{selection[group.key + ':' + item.value] ? 'selected' : ''}}" data-key="{{group.key}}" data-value="{{item.value}}" bindtap="toggle"><view class="ui-option-face">{{item.name}}</view></view></view></view></block>
    <block wx:if="{{filterTab === 'cap'}}"><view class="label">能力配置</view><view class="segments"><button class="ui-button choice {{!filters.factory ? 'active' : ''}}" data-value="no" bindtap="factory">满配可获得</button><button class="ui-button choice {{filters.factory ? 'active' : ''}}" data-value="yes" bindtap="factory">出厂即有</button></view><view class="muted">关闭时按满配可获得；多个能力同时满足。未知能力不命中。</view><view wx:for="{{capabilityGroups}}" wx:key="name" wx:for-item="group"><view class="label">{{group.name}}</view><view class="ui-option-grid"><view wx:for="{{group.options}}" wx:key="value" class="ui-option {{selection['capabilities:' + item.value] ? 'selected' : ''}}" data-key="capabilities" data-value="{{item.value}}" bindtap="toggle"><view class="ui-option-face">{{item.name}}</view></view></view></view></block>
    <block wx:if="{{filterTab === 'ammo'}}"><view class="label">弹种 · 可多选</view><view class="ui-option-grid"><view wx:for="{{ammoTypes}}" wx:key="value" class="ui-option {{selection['ammoTypes:' + item.value] ? 'selected' : ''}}" data-key="ammoTypes" data-value="{{item.value}}" bindtap="toggle"><view class="ui-option-face">{{item.name}}</view></view></view><view class="label">弹药特性 · 同时满足</view><view class="ui-option-grid"><view wx:for="{{ammoTraits}}" wx:key="value" class="ui-option {{selection['ammoTraits:' + item.value] ? 'selected' : ''}}" data-key="ammoTraits" data-value="{{item.value}}" bindtap="toggle"><view class="ui-option-face">{{item.name}}</view></view></view><view class="label">最高穿深 ≥ mm</view><input class="ui-field" type="digit" value="{{filters.penetration}}" data-key="penetration" bindinput="input" placeholder="不限"/><view class="muted">弹种、特性、穿深必须由同一枚弹药满足。</view></block>
    <block wx:if="{{filterTab === 'perf'}}"><view class="label">最高速度 ≥ km/h</view><input class="ui-field" type="digit" value="{{filters.speed}}" data-key="speed" bindinput="input" placeholder="不限"/><view class="label">视野 ≥ m</view><input class="ui-field" type="digit" value="{{filters.view}}" data-key="view" bindinput="input" placeholder="不限"/><view class="label">隐蔽 ≥ %</view><input class="ui-field" type="digit" value="{{filters.camo}}" data-key="camo" bindinput="input" placeholder="不限"/></block>
    <block wx:if="{{filterTab === 'get'}}"><view class="label">获取方式</view><view class="ui-option-grid"><view wx:for="{{acquisitions}}" wx:key="value" class="ui-option {{selection['acquisition:' + item.value] ? 'selected' : ''}}" data-key="acquisition" data-value="{{item.value}}" bindtap="toggle"><view class="ui-option-face">{{item.name}}</view></view></view><view class="label">Premium</view><view class="segments"><button wx:for="{{booleanOptions}}" wx:key="*this" class="ui-button choice {{premiumIndex === index ? 'active' : ''}}" data-key="premium" data-value="{{index}}" bindtap="bool">{{item}}</button></view><view class="label">当前可研发</view><view class="segments"><button wx:for="{{booleanOptions}}" wx:key="*this" class="ui-button choice {{researchIndex === index ? 'active' : ''}}" data-key="researchable" data-value="{{index}}" bindtap="bool">{{item}}</button></view></block>
  </view>

    </scroll-view><view class="actions"><button class="ui-button ghost" bindtap="clear">重置条件</button><button class="ui-button primary" bindtap="closeFilters">查看 {{count}} 辆车辆</button></view>
  </view>
</block>

<view class="module-footer"><text class="link" bindtap="awHome">‹ AW 模块入口</text></view>

<aw-prerequisites wx:if="{{prerequisiteForm}}" vehicle-id="{{prerequisiteForm.vehicleId}}" member-id="{{prerequisiteForm.memberId}}" bind:saved="prerequisitesSaved" bind:cancel="closePrerequisites"/>
