@import "../../utils/aw/theme.wxss";
.search-card { padding:20rpx 24rpx; background:#fbfafc; border:1rpx solid rgba(28,26,30,.12); border-radius:18rpx; margin:18rpx 0; }
.search-label { margin:0 0 12rpx; font-size:26rpx; }
.search-input { display:block; width:100%; height:88rpx; }
.filter-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:18rpx 0 8rpx; }
.filter-toolbar button { min-width:220rpx; }
.filters .tag,.filter-content .tag { box-sizing:border-box; font-size:28rpx; line-height:1.5; padding:18rpx 24rpx; min-height:80rpx; margin:8rpx 16rpx 10rpx 0; border-radius:12rpx; }
.filter-content .label { font-size:26rpx; margin:28rpx 0 14rpx; }
.filter-name { margin-bottom:26rpx; height:88rpx; }
.result-meta { margin:18rpx 0 6rpx; }
.filter-scroll { white-space:nowrap; margin:12rpx 0 18rpx; }
.filter-tab { display:inline-block; padding:20rpx 24rpx; border-radius:12rpx; background:#ece9ed; color:#6b6370; font-size:28rpx; margin-right:16rpx; }
.filter-tab.active { background:#1c1a1e; color:#fff; }
.vehicle-name { font-size:32rpx; font-weight:900; line-height:1.35; flex:1; }
.vehicle-card { margin:14rpx 0; }
.vehicle-meta { margin:8rpx 0; }
