@import "../../utils/aw/theme.wxss";
.search-input { display:block; width:100%; height:96rpx; margin:22rpx 0 0; background:#fbfafc; }
.filter-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:14rpx 0; }
.filter-toolbar .filter-trigger { flex:none; width:auto; min-width:0; min-height:88rpx; margin:0; padding:20rpx 28rpx; }
.filters { display:flex; flex-wrap:wrap; gap:12rpx; margin:8rpx 0 18rpx; }
.filters .tag,.filter-content .tag { box-sizing:border-box; font-size:28rpx; line-height:1.5; padding:18rpx 24rpx; min-height:88rpx; margin:8rpx 16rpx 10rpx 0; border-radius:12rpx; }
.filter-content .label { font-size:26rpx; margin:28rpx 0 14rpx; }
.filter-name { margin-bottom:26rpx; height:88rpx; }
.result-meta { margin:18rpx 0 6rpx; }
.filter-scroll { white-space:normal; margin:12rpx 0 18rpx; }
.filter-tab { display:inline-block; box-sizing:border-box; min-height:88rpx; padding:20rpx 24rpx; border-radius:12rpx; background:#ece9ed; color:#6b6370; font-size:28rpx; margin:6rpx 12rpx 6rpx 0; }
.filter-tab.active { background:#1c1a1e; color:#fff; }
.vehicle-name { font-size:32rpx; font-weight:900; line-height:1.35; flex:1; }
.vehicle-meta { margin:8rpx 0; }

.filters .tag { margin:0; }
