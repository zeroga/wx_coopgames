@import "../../utils/aw/theme.wxss";
.search-input { margin:22rpx 0 0; }
.filter-toolbar { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin:14rpx 0; }
.filters { display:flex; flex-wrap:wrap; gap:0 12rpx; margin:8rpx 0 18rpx; }
.filters .ui-option { margin-right:0; }
.filter-content .label { font-size:23rpx; margin:24rpx 0 8rpx; }
.result-meta { margin:18rpx 0 6rpx; }
.filter-scroll { display:flex; flex-wrap:wrap; gap:5rpx; padding:5rpx; margin:12rpx 0 18rpx; background:#dedbe0; border-radius:16rpx; }
.filter-tab { flex:1 0 auto; }
.filter-content { padding-bottom:12rpx; }
.vehicle-meta { margin:8rpx 0; }
.catalog-tools .search-input { margin:0; height:72rpx; min-height:72rpx; }
.catalog-tools .filter-toolbar { margin:12rpx 0 0; }
.catalog-tools .filters { margin:12rpx 0 0; }
.catalog-tools .result-meta { margin:12rpx 0 0; }
.catalog-note { text-align:center; padding:12rpx 18rpx; }
@import "../../utils/ui/components.wxss";

.sheet { display:flex; flex-direction:column; }
.sheet-head,.filter-scroll,.sheet .actions { flex:none; }
.sheet-content { flex:0 1 auto; min-height:0; }
