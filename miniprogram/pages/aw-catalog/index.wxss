@import "../../utils/aw/theme.wxss";
.search-row { display:flex; align-items:center; gap:12rpx; margin:18rpx 0 8rpx; }
.search-row button { flex:none; white-space:nowrap; }
.search-row input { flex:1; min-width:0; background:#fff; }
.result-meta { margin:18rpx 0 6rpx; }
.filter-scroll { white-space:nowrap; margin:12rpx 0 18rpx; }
.filter-tab { display:inline-block; padding:16rpx 18rpx; border-radius:12rpx; background:#ece9ed; color:#6b6370; font-size:24rpx; margin-right:10rpx; }
.filter-tab.active { background:#1c1a1e; color:#fff; }
.vehicle-name { font-size:32rpx; font-weight:900; line-height:1.35; flex:1; }
.vehicle-card { margin:14rpx 0; }
.vehicle-meta { margin:8rpx 0; }
