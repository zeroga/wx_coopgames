<view class="aw-page">
  <view wx:if="{{fieldError && !memberForm && !roleForm}}" class="warning">{{fieldError}}</view>
  <view wx:if="{{syncError}}" class="warning">{{syncError}}</view>
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · TEAM</view><view class="title">车队管理</view><view class="subtitle">{{members.length}} 名成员 · 职责安排与获取规划</view></view>
  <view class="card fleet-status"><view class="row between"><text class="card-title">{{connected ? archive.name : '本地车队'}}</text><text class="muted">{{busy ? '正在同步' : sync.status}}</text></view><view class="muted">{{currentId ? selfName + ' · 我的玩家档' : '尚未关联我的玩家档'}}{{connected ? ' · 已连接车队' : ''}}</view><view class="muted">资料 {{catalogInfo.versionText}} · {{catalogInfo.status}}</view><view wx:if="{{catalogInfo.error}}" class="muted">{{catalogInfo.error}}</view><view class="actions"><button class="ghost small" disabled="{{busy || catalogInfo.busy}}" loading="{{busy || catalogInfo.busy}}" bindtap="refreshCloud">刷新</button><button class="ghost small" disabled="{{busy}}" bindtap="archives">{{showArchives ? '收起存档管理' : '管理存档'}}</button></view></view>
  <view wx:if="{{sync.error && !syncError}}" class="warning">{{sync.error}}</view>
  <view wx:if="{{showArchives}}" class="card">
    <view class="card-title">存档管理</view>
    <block wx:if="{{connected}}"><view class="label code-type">车队码 · AW-T</view><view class="code">{{archive.teamCode}}</view><button class="ghost small" bindtap="copyTeam">复制车队码</button></block>
    <block wx:else=""><view class="label">读取已有车队</view><input placeholder="AW-T-车队码" maxlength="37" value="{{teamCodeInput}}" data-key="teamCodeInput" bindinput="archiveField"/><button class="primary archive-toggle" disabled="{{busy}}" bindtap="joinTeam">读取车队</button><view class="label">创建车队</view><input placeholder="车队名称" maxlength="60" value="{{teamNameInput}}" data-key="teamNameInput" bindinput="archiveField"/><button class="ghost archive-toggle" disabled="{{busy || !currentId}}" bindtap="createTeam">创建车队并生成车队码</button></block>
    <block wx:if="{{currentId}}"><view class="label">{{selfName}} · 我的玩家码</view><view wx:if="{{selfArchive.code}}" class="code">{{selfArchive.code}}</view><view wx:else="" class="muted">生成玩家码后，改动会自动上传。</view><button wx:if="{{selfArchive.code}}" class="ghost small" bindtap="copyMember">复制我的玩家码</button><button wx:else="" class="primary" disabled="{{busy}}" bindtap="publishMember">生成我的玩家码</button></block>
    <block wx:else=""><view class="label">读取我的玩家档</view><input placeholder="AW-M-我的玩家码" maxlength="37" value="{{memberCodeInput}}" data-key="memberCodeInput" bindinput="archiveField"/><view class="actions"><button class="primary" disabled="{{busy}}" bindtap="joinMember">读取我的玩家码</button><button class="ghost" disabled="{{busy}}" bindtap="newMember">建立我的玩家档</button></view></block>
    <view class="actions"><button class="ghost small" bindtap="backup">复制备份</button><button wx:if="{{connected}}" class="ghost small" disabled="{{busy}}" bindtap="switchLocal">切换存档</button><button wx:if="{{connected && dirty}}" class="danger small" disabled="{{busy}}" bindtap="replaceCloud">备份后载入云端</button><button wx:if="{{connected && currentId}}" class="danger small" disabled="{{busy}}" bindtap="unlinkMember">退出车队</button></view>
  </view>
  <view class="tabs sticky"><text class="tab {{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="tab">总览</text><text class="tab {{tab === 'players' ? 'active' : ''}}" data-tab="players" bindtap="tab">成员</text><text class="tab {{tab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="tab">获取规划</text><text class="tab {{tab === 'roles' ? 'active' : ''}}" data-tab="roles" bindtap="tab">职责</text></view>
  <block wx:if="{{tab === 'overview'}}">
    <view wx:if="{{!overview.length}}" class="empty">还没有自定义职责。先建立自己的玩家档和职责，再从车辆详情登记车辆。<button class="ghost" data-tab="roles" bindtap="tab">添加职责</button></view>
    <view wx:for="{{overview}}" wx:key="id" wx:for-item="role" class="card"><view class="card-title">{{role.name}}</view><view class="muted">{{role.description}}</view><view wx:for="{{role.groups}}" wx:key="level" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.vehicles}}" wx:key="id" wx:for-item="vehicle" class="line"><view class="link" data-id="{{vehicle.id}}" bindtap="detail">{{vehicle.name}} ›</view><view wx:for="{{vehicle.members}}" wx:key="id" wx:for-item="player"><view class="row between"><text>{{player.memberName}} · {{player.statusText}}</text><text wx:if="{{player.memberId === currentId}}" class="link" data-id="{{vehicle.id}}" data-member="{{player.memberId}}" bindtap="editAsset">编辑</text></view><view wx:for="{{player.roles}}" wx:key="id" wx:for-item="assignment" wx:if="{{assignment.roleId === role.id && assignment.targetNames}}" class="muted">{{assignment.sourceText}} → {{assignment.targetNames}}</view></view></view><view wx:if="{{!group.vehicles.length}}" class="muted">暂无车辆</view></view></view>
  </block>
  <block wx:if="{{tab === 'players'}}">
    <input wx:if="{{members.length > 6}}" placeholder="搜索成员" value="{{memberSearch}}" bindinput="memberSearch"/>
    <view wx:for="{{visibleMembers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectMember" class="card player {{memberId === item.id ? 'selected' : ''}}"><view class="row between"><view ><view class="card-title">{{item.name}} {{item.active ? '' : '（停用）'}}</view><view class="muted">已拥有 {{item.owned}} · 计划 {{item.planned}}{{currentId === item.id ? ' · 我' : ''}}</view></view></view></view>
    <view wx:if="{{member}}" class="card"><view class="card-title">{{member.name}}{{member.id === currentId ? ' · 我' : ''}}</view><view wx:if="{{!canEditMember}}" class="muted">队友资料仅供查看。</view><view wx:if="{{canEditMember}}" class="actions"><button class="ghost small" bindtap="renameMember">修改我的名字</button></view>
      <view class="label">已拥有 {{member.owned}} · 计划 {{member.planned}}</view><view wx:for="{{playerAssets}}" wx:key="id" class="line"><view class="row between"><text data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} ›</text><text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:key="id" wx:for-item="role" wx:if="{{role.targetNames}}" class="muted">{{role.name}} · {{role.sourceText}} → {{role.targetNames}}</view><view class="actions"><button wx:if="{{member.id === currentId}}" class="ghost small" disabled="{{!member.active}}" data-id="{{item.vehicleId}}" bindtap="editAsset">编辑</button><button wx:if="{{canEditMember}}" class="danger small" data-asset="{{item.id}}" bindtap="removeAsset">移除</button></view></view><button wx:if="{{canEditMember}}" class="ghost" bindtap="addVehicle">+ 从资料库添加我的车辆</button>
      <view class="section-title">Token 来源与消耗</view><view class="muted">在车辆编辑中记录满经验奖励和实际解锁消耗，获取规划会计算各类 Token 的缺口与练车顺序。</view><button class="ghost" data-tab="plans" bindtap="tab">查看 Token 规划</button>
    </view><view wx:if="{{!members.length}}" class="empty">玩家使用稳定 ID，改名不会断开车辆关系。</view>
  </block>
  <block wx:if="{{tab === 'roles'}}">
    <button class="ghost" disabled="{{connected && !currentId}}" bindtap="newRole">+ 新建职责</button><view class="muted">拖动 ≡ 排序，或使用 ↑ / ↓ 调整。</view>
    <view wx:for="{{roles}}" wx:key="id" class="card role-sort {{draggingRole === item.id ? 'dragging' : ''}}"><view class="row"><view class="drag-handle" data-id="{{item.id}}" bindtouchstart="roleDragStart" catchtouchmove="roleDragMove" bindtouchend="roleDragEnd">≡</view><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view></view></view><view class="actions"><button class="ghost small" data-id="{{item.id}}" data-dir="-1" bindtap="moveRole">↑</button><button class="ghost small" data-id="{{item.id}}" data-dir="1" bindtap="moveRole">↓</button><button class="ghost small" data-id="{{item.id}}" bindtap="editRole">编辑</button><button class="danger small" data-id="{{item.id}}" bindtap="deleteRole">删除</button></view></view><view wx:if="{{!roles.length}}" class="empty">职责由团队自定义，例如抗线、侦察或步兵支援。</view>
  </block>
  <block wx:if="{{tab === 'plans'}}">
    <input wx:if="{{members.length > 6}}" placeholder="搜索成员" value="{{memberSearch}}" bindinput="memberSearch"/>
    <view class="member-buttons"><button wx:for="{{visibleMembers}}" wx:key="id" class="choice {{memberId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMember">{{item.name}}</button></view>
    <view wx:if="{{unionPlan}}" class="card"><view class="card-title">{{member.name}} · 全部车辆与 Token 规划</view><view class="warning">{{unionPlan.status}}</view><view>待获取 {{unionPlan.missing}} 辆 · 受阻 {{unionPlan.blocked.length}} 步</view><view class="muted">奖励只计算一次；先练车领取，再消耗解锁。资料缺失和未记录的历史消耗会单独提示。</view>
      <view wx:for="{{unionPlan.tokens}}" wx:key="id" wx:for-item="token" class="line"><view class="card-title">{{token.name}}</view><view class="muted">已记录领取 {{token.claimed}} − 实际消耗 {{token.historicalSpent}} = 可用 {{token.owned}}</view><view>本轮需要 {{token.consumed}} · 奖励上限 {{token.gained}} · 总量缺口 {{token.shortfall}}</view><view>当前顺序可获得 {{token.reachableGained}} · 下一步还缺 {{token.processShortfall}}</view><view class="muted">进度待确认 {{token.uncertain}}{{token.unknownSources ? ' · 数量未知来源 ' + token.unknownSources + ' 条' : ''}} · 预计最终余量 {{token.final}}</view><view wx:if="{{token.reserveShortfall}}" class="muted">原规划要求获取量严格大于消耗；还需 {{token.reserveShortfall}} 个余量。等量可以支付，但不满足余量要求。</view>
        <button class="ghost small" data-id="{{token.id}}" bindtap="tokenDetails">{{expandedTokens[token.id] ? '收起来源与消耗' : '查看来源、进度与补充车辆'}}</button>
        <block wx:if="{{expandedTokens[token.id]}}"><view class="label">奖励来源 · 需要练的车</view>
        <view wx:for="{{token.sources}}" wx:key="id" wx:for-item="source" class="source-row"><view class="link" data-id="{{source.vehicleId}}" bindtap="detail">{{source.name}} · ×{{source.quantity}} ›</view><view class="muted">{{source.owned ? '已拥有' : '计划获取后练满经验'}}{{source.state === 'unknown' ? ' · 进度未记录' : ''}}</view>
          <view wx:if="{{source.owned}}" class="segments"><button class="choice {{source.state === 'unearned' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="unearned" disabled="{{busy || !canEditMember}}" bindtap="rewardState">未满经验</button><button class="choice {{source.state === 'ready' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="ready" disabled="{{busy || !canEditMember}}" bindtap="rewardState">满经验待领取</button><button class="choice {{source.state === 'claimed' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="claimed" disabled="{{busy || !canEditMember}}" bindtap="rewardState">已领取</button></view>
        </view>
        <view wx:if="{{token.consumers.length}}" class="label">消耗用于解锁</view><view wx:for="{{token.consumers}}" wx:key="vehicleId" class="link" data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} · ×{{item.quantity}} ›</view>
        <view wx:if="{{token.candidates.length}}" class="label">可补充的来源 · 加入后才计入本轮</view><view wx:for="{{token.candidates}}" wx:key="id" class="source-row"><view class="link" data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} · ×{{item.quantity}} ›</view><button class="ghost small" data-id="{{item.vehicleId}}" disabled="{{busy || !canEditMember || !item.known}}" bindtap="addTokenSource">+ 加入练车计划</button></view></block>
      </view>
      <view wx:if="{{!unionPlan.tokens.length}}" class="muted">已知路线没有 Token 记录；资料不完整时不能认定为无消耗。</view>
      <view wx:for="{{unionPlan.blocked}}" wx:key="vehicleId" class="warning"><view class="link" data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} ›</view>{{item.reason}}</view>
      <view wx:for="{{unionPlan.warnings}}" wx:key="*this" class="muted">· {{item}}</view>
    </view>
    <view class="section-title">建议执行顺序</view><view wx:for="{{unionPlan.actions}}" wx:key="id" class="line"><view class="link" data-id="{{item.vehicleId}}" bindtap="detail">{{index + 1}}. {{item.name}} ›</view><view class="muted">{{item.text}}</view></view><view wx:if="{{!unionPlan.actions.length}}" class="muted">补齐奖励记录或加入计划后，显示可执行顺序。</view>
    <view class="section-title">路线详情</view><view wx:if="{{!targets.length}}" class="empty">登记“计划”车辆即可加入规划；可选分配职责，也可单独安排 Token 来源车。</view><button class="ghost" data-id="" bindtap="target">{{targetId ? '查看全部计划路线' : '正在查看全部计划路线'}}</button>
    <view wx:for="{{targets}}" wx:key="id" class="route-card {{targetId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="target"><view>{{item.name}}</view><view class="muted">{{item.roleName}} · {{item.levelText}}</view></view>
    <view wx:if="{{plan}}" class="card"><view class="card-title">{{targetId ? '选中目标路线' : '全部目标路线'}}</view><view wx:for="{{choices}}" wx:key="vehicleId" wx:for-item="choice"><view class="label">{{choice.name}} · 请选择路线</view><view wx:for="{{choice.paths}}" wx:key="id" class="route-card {{item.selected ? 'selected' : ''}}" data-vehicle="{{choice.vehicleId}}" data-id="{{item.id}}" bindtap="routeChoice"><view>{{item.name}} · {{item.is_complete ? '已采集' : '待补全'}}</view><view class="muted">{{item.details}}</view></view></view>
      <view wx:for="{{routeOptions}}" wx:key="vehicleId" wx:for-item="choice"><view class="label">{{choice.name}} · 路线选择</view><view wx:for="{{choice.paths}}" wx:key="id" class="route-card {{item.selected ? 'selected' : ''}}" data-vehicle="{{choice.vehicleId}}" data-id="{{item.id}}" bindtap="pickRoute"><view>{{item.name}}</view><view class="muted">{{item.details}}</view></view></view>
      <view wx:for="{{plan.steps}}" wx:key="id" wx:for-item="step" class="line"><view class="row between"><text class="link" data-id="{{step.id}}" bindtap="detail">{{step.owned ? '✓' : '○'}} {{step.name}} ›</text><button class="ghost small" data-id="{{step.id}}" bindtap="step">{{expandedSteps[step.id] ? '收起' : '展开条件'}}</button></view><view wx:if="{{step.blocked}}" class="warning">获取顺序在此处受阻，先查看上方 Token 来源与缺口。</view>
        <view wx:if="{{expandedSteps[step.id]}}"><view class="muted">{{step.pathName}}</view><view class="link" data-id="{{step.id}}" bindtap="tree">查看科技树 ›</view><view wx:for="{{step.changes}}" wx:key="*this" class="muted">{{item}}</view><view wx:for="{{step.requirements}}" wx:key="id"><view class="muted">{{item.description}}</view><view wx:if="{{!step.owned && !item.token_id && item.requirement_type !== 'own_vehicle'}}" class="segments"><button class="choice {{!item.confirmed ? 'active' : ''}}" data-id="{{item.id}}" data-value="no" disabled="{{busy || !canEditMember}}" bindtap="confirmRequirement">待确认</button><button class="choice {{item.confirmed ? 'active' : ''}}" data-id="{{item.id}}" data-value="yes" disabled="{{busy || !canEditMember}}" bindtap="confirmRequirement">条件已满足</button></view></view></view>
      </view>
    </view>
  </block>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{editVehicleId}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<block wx:if="{{memberForm || roleForm}}"><view class="form-backdrop" bindtap="cancelForm"></view><view class="form" style="bottom:{{keyboardHeight}}px;max-height:calc(90vh - {{keyboardHeight}}px)"><view wx:if="{{fieldError}}" class="warning">{{fieldError}}</view><view class="card-title">{{memberForm ? '玩家信息' : '职责信息'}}</view><block wx:if="{{memberForm}}"><view class="label">显示名称</view><input value="{{memberForm.name}}" disabled="{{busy}}" bindinput="memberName" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="60"/></block><block wx:if="{{roleForm}}"><view class="label">职责名称</view><input value="{{roleForm.name}}" data-key="name" disabled="{{busy}}" bindinput="roleField" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="60"/><view class="label">说明</view><textarea value="{{roleForm.description}}" data-key="description" disabled="{{busy}}" bindinput="roleField" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="500"/></block><view class="actions"><button class="ghost" bindtap="cancelForm">取消</button><button wx:if="{{memberForm}}" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveMember">保存</button><button wx:else="" class="primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveRole">保存</button></view></view></block>

<view class="module-footer"><text class="link" bindtap="awHome">‹ AW 模块入口</text></view>
