<view class="aw-page">
  <view class="title">车队</view><view class="subtitle">{{members.length}} 名玩家 · 自定义职责与车辆获取规划</view>
  <view class="nav"><button data-page="catalog" bindtap="nav">车辆资料库</button><button data-page="tree" bindtap="nav">科技树</button><button class="active">车队</button></view>
  <view class="card"><view class="row between"><text>{{connected ? '共享团队' : '本地测试'}} · {{dirty ? '有未同步改动' : '已保存'}}</text><text class="link" bindtap="backup">复制备份</text></view><view class="muted">编辑先保存在本地。连接共享团队后，手动上传或载入；本地测试无需执行 SQL。</view><view wx:if="connected" class="actions"><button class="ghost small" disabled="{{busy}}" bindtap="pull">载入云端</button><button class="primary small" disabled="{{busy}}" bindtap="push">上传本地改动</button></view><view wx:if="connected &amp;&amp; dirty" class="link" bindtap="replaceCloud">用云端替换本地版本</view><view wx:if="!connected" class="link" data-page="catalog" bindtap="nav">先开始本地交互测试 ›</view><view wx:if="connected" class="link" bindtap="importLegacy">读取旧计划（已保留 {{legacyCount}} 条迁移记录）</view></view>
  <view class="tabs sticky"><text class="tag {{tab === 'overview' ? 'selected' : ''}}" data-tab="overview" bindtap="tab">总览</text><text class="tag {{tab === 'players' ? 'selected' : ''}}" data-tab="players" bindtap="tab">玩家</text><text class="tag {{tab === 'plans' ? 'selected' : ''}}" data-tab="plans" bindtap="tab">获取规划</text><text class="tag {{tab === 'roles' ? 'selected' : ''}}" data-tab="roles" bindtap="tab">职责管理</text></view>
  <block wx:if="tab === 'overview'">
    <view wx:if="!overview.length" class="empty">还没有自定义职责。先添加玩家和职责，再从车辆详情登记车辆。<button class="ghost" data-tab="roles" bindtap="tab">添加职责</button></view>
    <view wx:for="{{overview}}" wx:key="id" wx:for-item="role" class="card"><view class="card-title">{{role.name}}</view><view class="muted">{{role.description}}</view><view wx:for="{{role.groups}}" wx:key="level" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.vehicles}}" wx:key="id" wx:for-item="vehicle" class="line"><view class="link" data-id="{{vehicle.id}}" bindtap="detail">{{vehicle.name}} ›</view><view wx:for="{{vehicle.members}}" wx:key="id" wx:for-item="player"><view class="row between"><text>{{player.memberName}} · {{player.statusText}}</text><text class="link" data-id="{{vehicle.id}}" data-member="{{player.memberId}}" bindtap="editAsset">编辑</text></view><view wx:for="{{player.roles}}" wx:key="id" wx:for-item="assignment" wx:if="assignment.roleId === role.id &amp;&amp; assignment.targetNames" class="muted">{{assignment.sourceText}} → {{assignment.targetNames}}</view></view></view><view wx:if="!group.vehicles.length" class="muted">暂无车辆</view></view></view>
  </block>
  <block wx:if="tab === 'players'">
    <button class="ghost" bindtap="newMember">+ 添加玩家</button>
    <view wx:for="{{members}}" wx:key="id" class="card player {{memberId === item.id ? 'selected' : ''}}"><view class="row between"><view data-id="{{item.id}}" bindtap="selectMember"><view class="card-title">{{item.name}} {{item.active ? '' : '（停用）'}}</view><view class="muted">已拥有 {{item.owned}} · 计划 {{item.planned}}{{currentId === item.id ? ' · 当前玩家' : ''}}</view></view><view class="row"><text class="link" data-id="{{item.id}}" data-dir="-1" bindtap="moveMember">↑</text><text class="link" data-id="{{item.id}}" data-dir="1" bindtap="moveMember">↓</text></view></view></view>
    <view wx:if="member" class="card"><view class="card-title">{{member.name}}</view><view class="actions"><button class="ghost small" bindtap="renameMember">改名</button><button class="ghost small" disabled="{{!member.active}}" bindtap="setCurrent">设为当前玩家</button><button class="danger small" bindtap="activeMember">{{member.active ? '停用' : '恢复'}}</button></view>
      <view class="label">已拥有 {{member.owned}} · 计划 {{member.planned}}</view><view wx:for="{{playerAssets}}" wx:key="id" class="line"><view class="row between"><text data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} ›</text><text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:key="id" wx:for-item="role" wx:if="role.targetNames" class="muted">{{role.name}} · {{role.sourceText}} → {{role.targetNames}}</view><view class="actions"><button class="ghost small" disabled="{{!member.active}}" data-id="{{item.vehicleId}}" bindtap="editAsset">编辑</button><button class="danger small" data-asset="{{item.id}}" bindtap="removeAsset">移除</button></view></view><button class="ghost" bindtap="addVehicle">+ 从资料库添加车辆</button>
      <view class="section-title">Token 当前持有量</view><view class="muted">仅填写当前实际持有数量，过去奖励不要重复计入。</view><view wx:for="{{memberTokens}}" wx:key="id"><view class="label">{{item.name}}</view><input type="number" value="{{item.quantity}}" data-id="{{item.id}}" bindblur="token"/></view>
    </view><view wx:if="!members.length" class="empty">玩家使用稳定 ID，改名不会断开车辆关系。</view>
  </block>
  <block wx:if="tab === 'roles'">
    <button class="ghost" bindtap="newRole">+ 新建职责</button><view class="muted">拖动 ≡ 排序，或使用 ↑ / ↓ 调整。</view>
    <view wx:for="{{roles}}" wx:key="id" class="card role-sort {{draggingRole === item.id ? 'dragging' : ''}}"><view class="row"><view class="drag-handle" data-id="{{item.id}}" bindtouchstart="roleDragStart" catchtouchmove="roleDragMove" bindtouchend="roleDragEnd">≡</view><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view></view></view><view class="actions"><button class="ghost small" data-id="{{item.id}}" data-dir="-1" bindtap="moveRole">↑</button><button class="ghost small" data-id="{{item.id}}" data-dir="1" bindtap="moveRole">↓</button><button class="ghost small" data-id="{{item.id}}" bindtap="editRole">编辑</button><button class="danger small" data-id="{{item.id}}" bindtap="deleteRole">删除</button></view></view><view wx:if="!roles.length" class="empty">职责由团队自定义，例如抗线、侦察或步兵支援。</view>
  </block>
  <block wx:if="tab === 'plans'">
    <picker wx:if="members.length" range="{{members}}" range-key="name" value="{{memberIndex}}" bindchange="pickMember"><view class="picker">{{member.name}} ▾</view></picker>
    <view wx:if="!targets.length" class="empty">暂无正式计划目标。将车辆设为“计划”，并分配一个职责下的主力或备选，即可展开前置。</view>
    <view wx:for="{{targets}}" wx:key="id" class="card {{targetId === item.id ? 'player selected' : ''}}" data-id="{{item.id}}" bindtap="target"><view>{{item.name}}</view><view class="muted">{{item.roleName}} · {{item.levelText}}</view></view>
    <view wx:if="plan" class="card"><view class="card-title">目标获取路线</view><view class="warning">{{plan.status}} · 已拥有 {{plan.ownedCount}} / {{plan.count}} 个路线节点</view>
      <view wx:for="{{choices}}" wx:key="vehicleId"><view class="label">{{item.name}} · 请选择完整路线</view><picker range="{{item.paths}}" range-key="name" value="{{item.index}}" data-index="{{index}}" bindchange="routeChoice"><view class="picker">选择获取路线 ▾</view></picker></view>
      <view wx:for="{{routeOptions}}" wx:key="vehicleId"><view class="label">{{item.name}} · 路线选择</view><picker range="{{item.paths}}" range-key="name" value="{{item.index}}" data-vehicle="{{item.vehicleId}}" bindchange="route"><view class="picker">{{item.index >= 0 ? item.paths[item.index].name : '请选择'}} ▾</view></picker></view>
      <view wx:for="{{plan.steps}}" wx:key="id" wx:for-item="step" class="line"><view class="row between"><text data-id="{{step.id}}" bindtap="detail">{{step.owned ? '✓' : '○'}} {{step.name}} ›</text><text class="tag">{{step.owned ? '已拥有' : '计划'}}</text></view><view class="muted">{{step.pathName}}</view><view wx:if="step.blocked" class="warning">路线在此处中断：Token 余额不足</view><view wx:for="{{step.changes}}" wx:key="*this" class="muted">{{item}}</view>
        <view wx:for="{{step.requirements}}" wx:key="id" class="row between"><text class="muted">{{item.description}}</text><switch wx:if="!step.owned &amp;&amp; !item.token_id &amp;&amp; item.requirement_type !== 'own_vehicle'" checked="{{item.confirmed}}" data-id="{{item.id}}" bindchange="confirmRequirement" color="#504060"/></view>
        <view wx:for="{{step.rewards}}" wx:key="id"><view class="muted">{{item.tokenName}} ×{{item.quantity}} · {{item.description}}</view><view wx:if="!step.owned" class="row between"><text class="muted">已确认本节点完成时可领取</text><switch checked="{{item.confirmed}}" data-id="{{item.id}}" bindchange="confirmReward" color="#504060"/></view><view wx:else="" class="muted">既有车辆奖励请计入当前持有量，不重复预计获取。</view></view>
      </view>
      <view wx:for="{{plan.warnings}}" wx:key="*this" class="muted">· {{item}}</view><view class="muted">条件开关仅表示你已核实可满足该条件，不会修改公开资料。</view>
    </view>
    <view wx:if="unionPlan" class="card"><view class="card-title">该玩家全部目标 · Token 合并检查</view><view class="warning">{{unionPlan.status}}</view><view class="muted">共享前置与奖励只计算一次；每种 Token 独立检查。</view><view wx:for="{{unionPlan.tokens}}" wx:key="id" class="line"><view>{{item.name}}</view><view class="muted">当前持有 {{item.owned}} + 确认获取 {{item.gained}} · 待确认获取 {{item.uncertain}}</view><view class="muted">消耗 {{item.consumed}} · 最终余额 {{item.final}}</view><view>总量：{{item.totalOk ? '✓ 满足严格大于规则' : '✕ 不满足严格大于规则'}}</view><view>过程：{{item.processOk ? '✓ 已知 Token 步骤可执行' : '✕ 中途余额不足'}}</view></view><view wx:if="!unionPlan.tokens.length" class="muted">所选已知路线暂无 Token 记录；路线不完整时仍无法确认。</view></view>
  </block>
  <aw-asset-editor wx:if="editor" vehicle-id="{{editVehicleId}}" member-id="{{editMemberId}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<block wx:if="memberForm || roleForm"><view class="form-backdrop" bindtap="cancelForm"></view><view class="form"><view class="card-title">{{memberForm ? '玩家信息' : '职责信息'}}</view><block wx:if="memberForm"><view class="label">显示名称</view><input value="{{memberForm.name}}" bindinput="memberName" maxlength="60"/></block><block wx:if="roleForm"><view class="label">职责名称</view><input value="{{roleForm.name}}" data-key="name" bindinput="roleField" maxlength="60"/><view class="label">说明</view><textarea value="{{roleForm.description}}" data-key="description" bindinput="roleField" maxlength="500"/></block><view class="actions"><button class="ghost" bindtap="cancelForm">取消</button><button wx:if="memberForm" class="primary" bindtap="saveMember">保存</button><button wx:else="" class="primary" bindtap="saveRole">保存</button></view></view></block>
