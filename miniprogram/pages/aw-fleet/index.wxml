<view class="aw-page">
  <view wx:if="{{fieldError && !memberForm && !roleForm}}" class="ui-error">{{fieldError}}</view>
  <view wx:if="{{syncError}}" class="ui-error">{{syncError}}</view>
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · TEAM</view><view class="title">车队管理</view><view class="subtitle">{{members.length}} 名成员 · 职责安排与获取规划</view></view>
  <view class="ui-card card fleet-status"><view class="row between"><text class="card-title">{{connected ? archive.name : '本地车队'}}</text><text class="muted">{{busy ? '正在同步' : sync.status}}</text></view><view class="muted">{{currentId ? selfName + ' · 我的玩家档' : '尚未关联我的玩家档'}}{{connected ? ' · 已连接车队' : ''}}</view><view class="muted">资料 {{catalogInfo.versionText}} · {{catalogInfo.status}}</view><view wx:if="{{catalogInfo.error}}" class="ui-error">{{catalogInfo.error}}</view><view class="actions"><button class="ui-button ui-compact ghost small" disabled="{{busy || catalogInfo.busy}}" loading="{{busy || catalogInfo.busy}}" bindtap="refreshCloud">刷新</button><button class="ui-button ui-compact ghost small" disabled="{{busy}}" bindtap="archives">{{showArchives ? '收起存档管理' : '管理存档'}}</button></view></view>
  <view wx:if="{{sync.error && !syncError}}" class="ui-error">{{sync.error}}</view>
  <view wx:if="{{showArchives}}" class="ui-card card">
    <view class="card-title">存档管理</view>
    <block wx:if="{{connected}}"><view class="label code-type">车队码 · AW-T</view><view class="code">{{archive.teamCode}}</view><button class="ui-button ui-compact ghost small" bindtap="copyTeam">复制车队码</button></block>
    <block wx:else=""><view class="label">读取已有车队</view><input class="ui-field" placeholder="AW-T-车队码" maxlength="37" value="{{teamCodeInput}}" data-key="teamCodeInput" bindinput="archiveField"/><button class="ui-button primary archive-toggle" disabled="{{busy}}" bindtap="joinTeam">读取车队</button><view class="label">创建车队</view><input class="ui-field" placeholder="车队名称" maxlength="60" value="{{teamNameInput}}" data-key="teamNameInput" bindinput="archiveField"/><button class="ui-button ghost archive-toggle" disabled="{{busy || !currentId}}" bindtap="createTeam">创建车队并生成车队码</button></block>
    <block wx:if="{{currentId}}"><view class="label">{{selfName}} · 我的玩家码</view><view wx:if="{{selfArchive.code}}" class="code">{{selfArchive.code}}</view><view wx:else="" class="muted">生成玩家码后，改动会自动上传。</view><button wx:if="{{selfArchive.code}}" class="ui-button ui-compact ghost small" bindtap="copyMember">复制我的玩家码</button><button wx:else="" class="ui-button primary" disabled="{{busy}}" bindtap="publishMember">生成我的玩家码</button></block>
    <block wx:else=""><view class="label">读取我的玩家档</view><input class="ui-field" placeholder="AW-M-我的玩家码" maxlength="37" value="{{memberCodeInput}}" data-key="memberCodeInput" bindinput="archiveField"/><view class="actions"><button class="ui-button primary" disabled="{{busy}}" bindtap="joinMember">读取我的玩家码</button><button class="ui-button ghost" disabled="{{busy}}" bindtap="newMember">建立我的玩家档</button></view></block>
    <view class="actions"><button class="ui-button ui-compact ghost small" bindtap="backup">复制备份</button><button wx:if="{{connected}}" class="ui-button ui-compact ghost small" disabled="{{busy}}" bindtap="switchLocal">切换存档</button><button wx:if="{{connected && dirty}}" class="ui-button ui-compact danger small" disabled="{{busy}}" bindtap="replaceCloud">备份后载入云端</button><button wx:if="{{connected && currentId}}" class="ui-button ui-compact danger small" disabled="{{busy}}" bindtap="unlinkMember">退出车队</button></view>
  </view>
  <view class="tabs sticky"><text class="ui-tab tab {{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="tab">总览</text><text class="ui-tab tab {{tab === 'players' ? 'active' : ''}}" data-tab="players" bindtap="tab">成员</text><text class="ui-tab tab {{tab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="tab">获取规划</text><text class="ui-tab tab {{tab === 'roles' ? 'active' : ''}}" data-tab="roles" bindtap="tab">职责</text></view>
  <block wx:if="{{tab === 'overview'}}">
    <view wx:if="{{!overview.length && !undefinedVehicles.length}}" class="ui-card card empty">还没有自定义职责。先建立自己的玩家档和职责，再从车辆详情登记车辆。<button class="ui-button ghost" data-tab="roles" bindtap="tab">添加职责</button></view>
    <view class="overview-grid"><view wx:for="{{overview}}" wx:key="id" wx:for-item="role" class="ui-card card role-group"><view class="card-title">{{role.name}}</view><view class="muted">{{role.description}}</view><view wx:for="{{role.groups}}" wx:key="level" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.vehicles}}" wx:key="id" wx:for-item="vehicle" class="ui-card vehicle-card"><view class="vehicle-heading vehicle-open" data-id="{{vehicle.id}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{vehicle.id}}" name="{{vehicle.name}}" markers="{{vehicle.markers}}" plans="{{vehicle.members}}" plan-mode="auto" data-plan-key="{{vehicle.planKey}}" bind:planlayout="planLayout" bind:configure="configurePrerequisites" catalog-revision="{{catalogRevision}}"/></view><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view><view wx:if="{{planModes[vehicle.planKey] === 'summary' && vehicle.editMemberId}}" class="vehicle-toolbar"><button class="ui-button quiet-control" data-id="{{vehicle.id}}" data-member="{{vehicle.editMemberId}}" bindtap="editAsset" aria-label="编辑我的车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button></view><view wx:if="{{planModes[vehicle.planKey] !== 'summary'}}" wx:for="{{vehicle.members}}" wx:key="id" wx:for-item="player"><view class="row between"><text><text class="member-dot" style="background:{{player.color}}"></text>{{player.memberName}} · {{player.statusText}}</text><button wx:if="{{player.memberId === currentId}}" class="ui-button quiet-control" data-id="{{vehicle.id}}" data-member="{{player.memberId}}" bindtap="editAsset" aria-label="编辑车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button></view><view class="muted">{{player.roleText}}</view><view wx:if="{{player.planText}}" class="muted">{{player.planText}}</view><view wx:for="{{player.roles}}" wx:key="id" wx:for-item="assignment" wx:if="{{assignment.roleId === role.id && assignment.targetNames}}" class="muted"><view>{{assignment.sourceText}} →</view><view wx:for="{{assignment.targetVehicles}}" wx:key="id" wx:for-item="target" class="ui-card vehicle-card target-vehicle"><aw-vehicle-label vehicle-id="{{target.id}}" name="{{target.name}}" catalog-revision="{{catalogRevision}}"/></view></view></view></view><view wx:if="{{!group.vehicles.length}}" class="muted">暂无车辆</view></view></view>
    </view><view wx:if="{{undefinedVehicles.length}}" class="ui-card card undefined-group"><button class="ui-button ghost undefined-toggle" bindtap="toggleUndefined" aria-label="{{undefinedExpanded ? '收起' : '展开'}}未定义职责车辆">未定义职责 · {{undefinedVehicles.length}} 辆 <image class="ui-action-icon" src="/assets/icons/{{undefinedExpanded ? 'up' : 'down'}}.svg"/></button><view wx:if="{{undefinedExpanded}}" wx:for="{{undefinedVehicles}}" wx:key="id" wx:for-item="vehicle" class="ui-card vehicle-card"><view class="vehicle-heading vehicle-open" data-id="{{vehicle.id}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{vehicle.id}}" name="{{vehicle.name}}" markers="{{vehicle.markers}}" plans="{{vehicle.members}}" plan-mode="auto" data-plan-key="{{vehicle.planKey}}" bind:planlayout="planLayout" bind:configure="configurePrerequisites" catalog-revision="{{catalogRevision}}"/></view><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view><view wx:if="{{planModes[vehicle.planKey] === 'summary' && vehicle.editMemberId}}" class="vehicle-toolbar"><button class="ui-button quiet-control" data-id="{{vehicle.id}}" data-member="{{vehicle.editMemberId}}" bindtap="editAsset" aria-label="编辑我的车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button></view><view wx:if="{{planModes[vehicle.planKey] !== 'summary'}}" wx:for="{{vehicle.members}}" wx:key="id" wx:for-item="player" class="row between"><text>{{player.memberName}} · {{player.statusText}} · {{player.roleText}}</text><button wx:if="{{player.memberId === currentId}}" class="ui-button quiet-control" data-id="{{vehicle.id}}" data-member="{{player.memberId}}" bindtap="editAsset" aria-label="编辑车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button></view></view></view>
  </block>
  <block wx:if="{{tab === 'players'}}">
    <view wx:if="{{members.length > 6}}" class="ui-card card member-search"><input class="ui-field" placeholder="搜索成员" value="{{memberSearch}}" bindinput="memberSearch"/></view>
    <view wx:for="{{visibleMembers}}" wx:key="id" data-id="{{item.id}}" bindtap="selectMember" class="ui-card card player {{memberId === item.id ? 'selected' : ''}}"><view class="row between"><view ><view class="card-title">{{item.name}} {{item.active ? '' : '（停用）'}}</view><view class="muted">已拥有 {{item.owned}} · 计划 {{item.planned}}{{currentId === item.id ? ' · 我' : ''}}</view></view></view></view>
    <view wx:if="{{member}}" class="member-detail"><view class="ui-card card member-header"><view class="card-title">{{member.name}}{{member.id === currentId ? ' · 我' : ''}}</view><view wx:if="{{!canEditMember}}" class="muted">队友资料仅供查看。</view><view wx:if="{{canEditMember}}" class="actions"><button class="ui-button ui-compact ghost small" bindtap="renameMember">修改我的名字</button></view>
      <view class="member-count muted">已拥有 {{member.owned}} · 计划 {{member.planned}}</view></view>
      <view wx:for="{{memberAssignedAssets}}" wx:key="id" class="ui-card vehicle-card vehicle-entry">
        <view class="vehicle-heading"><view class="vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view>
        <view class="vehicle-toolbar"><view class="vehicle-meta"><text class="tag">{{item.statusText}}</text><text class="muted">{{item.roleText}}</text></view>
          <button wx:if="{{item.status === 'planned'}}" class="ui-button {{item.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-vehicle="{{item.vehicleId}}" data-member="{{member.id}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{item.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button>
          <button wx:if="{{member.id === currentId}}" class="ui-button quiet-control" disabled="{{!member.active}}" data-id="{{item.vehicleId}}" bindtap="editAsset" aria-label="编辑车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button><button wx:if="{{canEditMember}}" class="ui-button quiet-control danger" data-asset="{{item.id}}" bindtap="removeAsset" aria-label="移除车辆"><image class="ui-action-icon" src="/assets/icons/delete.svg"/></button>
        </view><view wx:if="{{item.customPrerequisite}}" class="custom-prerequisite">自定义前置</view><view wx:for="{{item.roles}}" wx:key="id" wx:for-item="role" wx:if="{{role.targetNames}}" class="muted"><view>{{role.name}} · {{role.sourceText}} →</view><view wx:for="{{role.targetVehicles}}" wx:key="id" wx:for-item="target" class="ui-card vehicle-card target-vehicle"><aw-vehicle-label vehicle-id="{{target.id}}" name="{{target.name}}" catalog-revision="{{catalogRevision}}"/></view></view>
      </view>
      <view wx:if="{{memberUndefinedAssets.length}}" class="ui-card card member-undefined"><button class="ui-button ghost undefined-toggle" bindtap="toggleMemberUndefined" aria-label="{{memberUndefinedExpanded ? '收起' : '展开'}}未定义职责车辆">未定义职责 · {{memberUndefinedAssets.length}} 辆 <image class="ui-action-icon" src="/assets/icons/{{memberUndefinedExpanded ? 'up' : 'down'}}.svg"/></button><block wx:if="{{memberUndefinedExpanded}}"><view wx:for="{{memberUndefinedAssets}}" wx:key="id" class="ui-card vehicle-card vehicle-entry">
        <view class="vehicle-heading"><view class="vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view>
        <view class="vehicle-toolbar"><view class="vehicle-meta"><text class="tag">{{item.statusText}}</text><text class="muted">{{item.roleText}}</text></view>
          <button wx:if="{{item.status === 'planned'}}" class="ui-button {{item.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-vehicle="{{item.vehicleId}}" data-member="{{member.id}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{item.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button>
          <button wx:if="{{member.id === currentId}}" class="ui-button quiet-control" disabled="{{!member.active}}" data-id="{{item.vehicleId}}" bindtap="editAsset" aria-label="编辑车辆"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button><button wx:if="{{canEditMember}}" class="ui-button quiet-control danger" data-asset="{{item.id}}" bindtap="removeAsset" aria-label="移除车辆"><image class="ui-action-icon" src="/assets/icons/delete.svg"/></button>
        </view><view wx:if="{{item.customPrerequisite}}" class="custom-prerequisite">自定义前置</view><view wx:for="{{item.roles}}" wx:key="id" wx:for-item="role" wx:if="{{role.targetNames}}" class="muted"><view>{{role.name}} · {{role.sourceText}} →</view><view wx:for="{{role.targetVehicles}}" wx:key="id" wx:for-item="target" class="ui-card vehicle-card target-vehicle"><aw-vehicle-label vehicle-id="{{target.id}}" name="{{target.name}}" catalog-revision="{{catalogRevision}}"/></view></view>
      </view></block></view>
      <view wx:if="{{canEditMember}}" class="ui-card card member-tools"><button class="ui-button ghost" bindtap="addVehicle">+ 从资料库添加我的车辆</button></view>
      <view class="ui-card card member-token"><view class="card-title">Token 来源与消耗</view><view class="muted">在车辆编辑中记录满经验奖励和实际解锁消耗，获取规划会计算各类 Token 的缺口与练车顺序。</view><button class="ui-button ghost" data-tab="plans" bindtap="tab">查看 Token 规划</button></view>
    </view><view wx:if="{{!members.length}}" class="ui-card card empty">玩家使用稳定 ID，改名不会断开车辆关系。</view>
  </block>
  <block wx:if="{{tab === 'roles'}}">
    <view class="ui-card card role-tools"><button class="ui-button ghost" disabled="{{connected && !currentId}}" bindtap="newRole">+ 新建职责</button><view class="muted">拖动把手排序，也可使用上移、下移按钮。</view></view>
    <view wx:for="{{roles}}" wx:key="id" class="ui-card card role-sort {{draggingRole === item.id ? 'dragging' : ''}}"><view class="role-row"><view class="drag-handle" data-id="{{item.id}}" bindtouchstart="roleDragStart" catchtouchmove="roleDragMove" bindtouchend="roleDragEnd" aria-label="拖动排序职责"><image class="ui-action-icon" src="/assets/icons/grip.svg"/></view><view class="role-title"><view class="card-title">{{item.name}}</view></view><view class="role-actions"><button class="ui-button quiet-control role-arrow" data-id="{{item.id}}" data-dir="-1" disabled="{{index === 0}}" bindtap="moveRole" aria-label="上移职责"><image class="ui-action-icon" src="/assets/icons/up.svg"/></button><button class="ui-button quiet-control role-arrow" data-id="{{item.id}}" data-dir="1" disabled="{{index === roles.length - 1}}" bindtap="moveRole" aria-label="下移职责"><image class="ui-action-icon" src="/assets/icons/down.svg"/></button><button class="ui-button quiet-control" data-id="{{item.id}}" bindtap="editRole" aria-label="编辑职责"><image class="ui-action-icon" src="/assets/icons/edit.svg"/></button><button class="ui-button quiet-control danger" data-id="{{item.id}}" bindtap="deleteRole" aria-label="删除职责"><image class="ui-action-icon" src="/assets/icons/delete.svg"/></button></view></view><view wx:if="{{item.description}}" class="role-description muted">{{item.description}}</view></view><view wx:if="{{!roles.length}}" class="ui-card card empty">职责由团队自定义，例如抗线、侦察或步兵支援。</view>
  </block>
  <block wx:if="{{tab === 'plans'}}">
    <view wx:if="{{members.length > 6}}" class="ui-card card member-search"><input class="ui-field" placeholder="搜索成员" value="{{memberSearch}}" bindinput="memberSearch"/></view>
    <view class="ui-card card planning-selector"><view class="card-title">选择成员</view><view class="member-buttons"><button wx:for="{{visibleMembers}}" wx:key="id" class="ui-button choice {{memberId === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="selectMember">{{item.name}}</button></view></view>
    <view wx:if="{{unionPlan}}" class="ui-card card"><view class="card-title">{{member.name}} · 全部车辆与 Token 规划</view><view class="warning">{{unionPlan.status}}</view><view>待获取 {{unionPlan.missing}} 辆 · 受阻 {{unionPlan.blocked.length}} 步</view><view class="muted">奖励只计算一次；先练车领取，再消耗解锁。未配置前置的车辆不会计入可获取奖励。</view>
      <view wx:for="{{unionPlan.tokens}}" wx:key="id" wx:for-item="token" class="line"><view class="card-title">{{token.name}}</view><view class="muted">已记录领取 {{token.claimed}} − 实际消耗 {{token.historicalSpent}} = 可用 {{token.owned}}</view><view>本轮需要 {{token.consumed}} · 奖励上限 {{token.gained}} · 总量缺口 {{token.shortfall}}</view><view>当前顺序可获得 {{token.reachableGained}} · 下一步还缺 {{token.processShortfall}}</view><view class="muted">进度未记录 {{token.uncertain}}{{token.unknownSources ? ' · 数量未知来源 ' + token.unknownSources + ' 条' : ''}} · 预计最终余量 {{token.final}}</view><view wx:if="{{token.reserveShortfall}}" class="muted">原规划要求获取量严格大于消耗；还需 {{token.reserveShortfall}} 个余量。等量可以支付，但不满足余量要求。</view>
        <button class="ui-button ui-compact ghost small" data-id="{{token.id}}" bindtap="tokenDetails">{{expandedTokens[token.id] ? '收起来源与消耗' : '查看来源、进度与补充车辆'}}</button>
        <block wx:if="{{expandedTokens[token.id]}}"><view class="label">奖励来源 · 需要练的车</view>
        <view wx:for="{{token.sources}}" wx:key="id" wx:for-item="source" class="ui-card vehicle-card source-row"><view class="vehicle-heading vehicle-open" data-id="{{source.vehicleId}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{source.vehicleId}}" name="{{source.name}}" catalog-revision="{{catalogRevision}}"/></view><text class="muted">×{{source.quantity}}</text><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view><view class="muted">{{source.owned ? '已拥有' : '计划获取后练满经验'}}{{source.state === 'unknown' ? ' · 进度未记录' : ''}}</view>
          <view wx:if="{{source.owned}}" class="segments"><button class="ui-button choice {{source.state === 'unearned' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="unearned" disabled="{{busy || !canEditMember}}" bindtap="rewardState">未满经验</button><button class="ui-button choice {{source.state === 'ready' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="ready" disabled="{{busy || !canEditMember}}" bindtap="rewardState">满经验待领取</button><button class="ui-button choice {{source.state === 'claimed' ? 'active' : ''}}" data-vehicle="{{source.vehicleId}}" data-id="{{source.id}}" data-state="claimed" disabled="{{busy || !canEditMember}}" bindtap="rewardState">已领取</button></view>
        </view>
        <view wx:if="{{token.consumers.length}}" class="label">消耗用于解锁</view><view wx:for="{{token.consumers}}" wx:key="vehicleId" class="ui-card vehicle-card vehicle-heading vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><text class="muted">×{{item.quantity}}</text><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view>
        <view wx:if="{{token.candidates.length}}" class="label">可补充的来源 · 加入后才计入本轮</view><view wx:for="{{token.candidates}}" wx:key="id" class="ui-card vehicle-card source-row"><view class="vehicle-heading vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><text class="muted">×{{item.quantity}}</text><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view><button class="ui-button quiet-control" data-id="{{item.vehicleId}}" disabled="{{busy || !canEditMember || !item.known}}" bindtap="addTokenSource">+ 加入练车计划</button></view></block>
      </view>
      <view wx:if="{{!unionPlan.tokens.length}}" class="muted">已知路线没有 Token 记录；资料不完整时不能认定为无消耗。</view>
      <view wx:for="{{unionPlan.blocked}}" wx:key="vehicleId" wx:if="{{item.reason !== '需要前置'}}" class="ui-card vehicle-card vehicle-warning"><view class="vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view>{{item.reason}}</view>
      <view wx:for="{{planningWarnings}}" wx:key="*this" class="muted">· {{item}}</view>
    </view>
    <view class="ui-card card section-heading"><view class="section-title">建议执行顺序</view></view><view wx:for="{{unionPlan.actions}}" wx:key="id" class="ui-card vehicle-card"><view class="vehicle-heading vehicle-open" data-id="{{item.vehicleId}}" bindtap="detail"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><image class="vehicle-chevron" src="/assets/icons/chevron-right.svg"/></view><view class="muted">{{index + 1}}. {{item.text}}</view></view><view wx:if="{{!unionPlan.actions.length}}" class="ui-card card empty">补齐奖励记录或加入计划后，显示可执行顺序。</view>
    <view class="ui-card card section-heading"><view class="section-title">路线详情</view><view wx:if="{{!targets.length}}" class="empty">登记“计划”车辆即可加入规划；可选分配职责，也可单独安排 Token 来源车。</view><button class="ui-button ghost" data-id="" bindtap="target">{{targetId ? '查看全部计划路线' : '正在查看全部计划路线'}}</button></view>
    <view wx:for="{{targets}}" wx:key="id" class="ui-card vehicle-card {{targetId === item.id ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="target"><view class="vehicle-heading"><view class="vehicle-label-wrap"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><button class="ui-button {{item.prerequisite.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-vehicle="{{item.vehicleId}}" data-member="{{memberId}}" catchtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{item.prerequisite.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button></view><view wx:if="{{item.prerequisite.customPrerequisite}}" class="custom-prerequisite">自定义前置</view><view class="muted">{{item.roleName}} · {{item.levelText}}</view></view>
    <view wx:if="{{plan}}" class="ui-card card"><view class="card-title">{{targetId ? '选中目标路线' : '全部目标路线'}}</view>      <view wx:for="{{plan.steps}}" wx:key="id" wx:for-item="step" class="ui-card vehicle-card"><view class="vehicle-heading"><view class="vehicle-open" data-id="{{step.id}}" bindtap="detail"><aw-vehicle-label vehicle-id="{{step.id}}" name="{{step.name}}" catalog-revision="{{catalogRevision}}"/></view></view><view class="vehicle-toolbar"><button wx:if="{{!step.owned}}" class="ui-button {{step.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-vehicle="{{step.id}}" data-member="{{memberId}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{step.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button><button wx:if="{{!step.ignored}}" class="ui-button quiet-control" data-id="{{step.id}}" bindtap="step">{{expandedSteps[step.id] ? '收起' : '展开条件'}}</button></view><view wx:if="{{step.ignored}}" class="muted">需要前置</view><view wx:if="{{step.custom}}" class="custom-prerequisite">自定义前置</view><view wx:if="{{step.blocked && !step.ignored}}" class="warning">需要前置</view>
        <view wx:if="{{!step.ignored && expandedSteps[step.id]}}"><view class="muted">{{step.pathName}}</view><view class="link" data-id="{{step.id}}" bindtap="tree">查看科技树 <image class="inline-chevron" src="/assets/icons/chevron-right.svg"/></view><view wx:for="{{step.changes}}" wx:key="*this" class="muted">{{item}}</view><view wx:for="{{step.requirements}}" wx:key="id"><view class="muted">{{item.description}}</view><view wx:if="{{!step.owned && !item.token_id && item.requirement_type !== 'own_vehicle'}}" class="segments"><button class="ui-button choice {{!item.confirmed ? 'active' : ''}}" data-id="{{item.id}}" data-value="no" disabled="{{busy || !canEditMember}}" bindtap="confirmRequirement">未标记满足</button><button class="ui-button choice {{item.confirmed ? 'active' : ''}}" data-id="{{item.id}}" data-value="yes" disabled="{{busy || !canEditMember}}" bindtap="confirmRequirement">条件已满足</button></view></view></view>
      </view>
    </view>
  </block>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{editVehicleId}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<block wx:if="{{memberForm || roleForm}}"><view class="form-backdrop" bindtap="cancelForm"></view><view class="form" style="bottom:{{keyboardHeight}}px;max-height:calc(90vh - {{keyboardHeight}}px)"><view wx:if="{{fieldError && fieldError !== '请填写成员名称' && fieldError !== '请填写职责名称'}}" class="ui-error">{{fieldError}}</view><view class="card-title">{{memberForm ? '玩家信息' : '职责信息'}}</view><block wx:if="{{memberForm}}"><view class="label">显示名称 <text class="field-required">*</text></view><input class="ui-field {{fieldError === '请填写成员名称' ? 'invalid' : ''}}" value="{{memberForm.name}}" disabled="{{busy}}" bindinput="memberName" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="60"/><view wx:if="{{fieldError === '请填写成员名称'}}" class="field-error">{{fieldError}}</view></block><block wx:if="{{roleForm}}"><view class="label">职责名称 <text class="field-required">*</text></view><input class="ui-field {{fieldError === '请填写职责名称' ? 'invalid' : ''}}" value="{{roleForm.name}}" data-key="name" disabled="{{busy}}" bindinput="roleField" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="60"/><view wx:if="{{fieldError === '请填写职责名称'}}" class="field-error">{{fieldError}}</view><view class="label">说明</view><textarea value="{{roleForm.description}}" data-key="description" disabled="{{busy}}" bindinput="roleField" bindkeyboardheightchange="keyboard" adjust-position="{{false}}" maxlength="500"/></block><view class="actions"><button class="ui-button ghost" bindtap="cancelForm">取消</button><button wx:if="{{memberForm}}" class="ui-button primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveMember">保存</button><button wx:else="" class="ui-button primary" loading="{{busy}}" disabled="{{busy}}" bindtap="saveRole">保存</button></view></view></block>

<view class="ui-card card module-footer"><text class="link" bindtap="awHome"><image class="inline-chevron" src="/assets/icons/chevron-left.svg"/> AW 模块入口</text></view>

<aw-prerequisites wx:if="{{prerequisiteForm}}" vehicle-id="{{prerequisiteForm.vehicleId}}" member-id="{{prerequisiteForm.memberId}}" bind:saved="prerequisitesSaved" bind:cancel="closePrerequisites"/>
