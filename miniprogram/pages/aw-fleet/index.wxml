<view class="aw-page">
  <view wx:if="{{syncError}}" class="warning">{{syncError}}</view>
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · TEAM</view><view class="title">车队管理</view><view class="subtitle">{{members.length}} 名成员 · 职责安排与获取规划</view></view>
  <view class="card"><view class="row between"><text class="card-title">{{connected ? archive.name : '本地车队'}}</text><text class="muted">{{dirty ? '有未上传改动' : '已保存'}}</text></view>
    <block wx:if="{{connected}}"><view class="label code-type">车队码 · AW-T</view><view class="code">{{archive.teamCode}}</view><view class="actions"><button class="ghost small" bindtap="copyTeam">复制车队码</button><button class="primary small" disabled="{{busy}}" bindtap="push">上传改动</button><button class="ghost small" disabled="{{busy}}" bindtap="pull">刷新</button></view><view class="actions"><button class="ghost small" bindtap="switchLocal">切换存档</button><button class="ghost small" bindtap="backup">备份</button><button wx:if="{{dirty}}" class="danger small" disabled="{{busy}}" bindtap="replaceCloud">载入云端</button></view></block>
    <block wx:else=""><view class="muted">先建立自己的玩家档，再创建车队。已有车队请先读取 AW-T 码，再输入自己的 AW-M 玩家码。</view><view class="label">读取已有车队</view><input placeholder="AW-T-车队码" maxlength="37" value="{{teamCodeInput}}" data-key="teamCodeInput" bindinput="archiveField"/><view class="actions"><button class="primary" disabled="{{busy}}" bindtap="joinTeam">读取车队</button><button class="ghost" bindtap="backup">备份本地</button></view><view class="label">创建车队</view><input placeholder="车队名称" maxlength="60" value="{{teamNameInput}}" data-key="teamNameInput" bindinput="archiveField"/><button class="ghost archive-toggle" disabled="{{busy || !currentId}}" bindtap="createTeam">创建车队并生成车队码</button></block>
  </view>
  <view class="card identity-card">
    <block wx:if="{{currentId}}"><view class="row between"><view class="card-title">{{selfName}} · 我的玩家档</view><text class="code-type">AW-M</text></view><view wx:if="{{selfArchive.code}}" class="code">{{selfArchive.code}}</view><view wx:else="" class="muted">本地玩家档，生成玩家码后可跨设备读取。</view><view class="actions"><button wx:if="{{selfArchive.code}}" class="ghost" bindtap="copyMember">复制我的玩家码</button><button wx:else="" class="primary" disabled="{{busy}}" bindtap="publishMember">生成我的玩家码</button><button wx:if="{{connected}}" class="danger" disabled="{{busy}}" bindtap="unlinkMember">退出车队</button></view></block>
    <block wx:else=""><view class="card-title">读取我的玩家档</view><view class="muted">{{connected ? '输入自己的玩家码；未入队时会先询问是否加入。' : '个人车辆与 Token 跟随玩家码，职责保存在各车队。'}}</view><input placeholder="AW-M-我的玩家码" maxlength="37" value="{{memberCodeInput}}" data-key="memberCodeInput" bindinput="archiveField"/><view class="actions"><button class="primary" disabled="{{busy}}" bindtap="joinMember">读取我的玩家码</button><button class="ghost" disabled="{{busy}}" bindtap="newMember">建立我的玩家档</button></view></block>
  </view>
  <view class="tabs sticky"><text class="tab {{tab === 'overview' ? 'active' : ''}}" data-tab="overview" bindtap="tab">总览</text><text class="tab {{tab === 'players' ? 'active' : ''}}" data-tab="players" bindtap="tab">成员</text><text class="tab {{tab === 'plans' ? 'active' : ''}}" data-tab="plans" bindtap="tab">获取规划</text><text class="tab {{tab === 'roles' ? 'active' : ''}}" data-tab="roles" bindtap="tab">职责</text></view>
  <block wx:if="{{tab === 'overview'}}">
    <view wx:if="{{!overview.length}}" class="empty">还没有自定义职责。先建立自己的玩家档和职责，再从车辆详情登记车辆。<button class="ghost" data-tab="roles" bindtap="tab">添加职责</button></view>
    <view wx:for="{{overview}}" wx:key="id" wx:for-item="role" class="card"><view class="card-title">{{role.name}}</view><view class="muted">{{role.description}}</view><view wx:for="{{role.groups}}" wx:key="level" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.vehicles}}" wx:key="id" wx:for-item="vehicle" class="line"><view class="link" data-id="{{vehicle.id}}" bindtap="detail">{{vehicle.name}} ›</view><view wx:for="{{vehicle.members}}" wx:key="id" wx:for-item="player"><view class="row between"><text>{{player.memberName}} · {{player.statusText}}</text><text wx:if="{{player.memberId === currentId}}" class="link" data-id="{{vehicle.id}}" data-member="{{player.memberId}}" bindtap="editAsset">编辑</text></view><view wx:for="{{player.roles}}" wx:key="id" wx:for-item="assignment" wx:if="{{assignment.roleId === role.id && assignment.targetNames}}" class="muted">{{assignment.sourceText}} → {{assignment.targetNames}}</view></view></view><view wx:if="{{!group.vehicles.length}}" class="muted">暂无车辆</view></view></view>
  </block>
  <block wx:if="{{tab === 'players'}}">
    <view wx:for="{{members}}" wx:key="id" class="card player {{memberId === item.id ? 'selected' : ''}}"><view class="row between"><view data-id="{{item.id}}" bindtap="selectMember"><view class="card-title">{{item.name}} {{item.active ? '' : '（停用）'}}</view><view class="muted">已拥有 {{item.owned}} · 计划 {{item.planned}}{{currentId === item.id ? ' · 我' : ''}}</view></view></view></view>
    <view wx:if="{{member}}" class="card"><view class="card-title">{{member.name}}{{member.id === currentId ? ' · 我' : ''}}</view><view wx:if="{{!canEditMember}}" class="muted">队友资料仅供查看。</view><view wx:if="{{canEditMember}}" class="actions"><button class="ghost small" bindtap="renameMember">修改我的名字</button></view>
      <view class="label">已拥有 {{member.owned}} · 计划 {{member.planned}}</view><view wx:for="{{playerAssets}}" wx:key="id" class="line"><view class="row between"><text data-id="{{item.vehicleId}}" bindtap="detail">{{item.name}} ›</text><text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:key="id" wx:for-item="role" wx:if="{{role.targetNames}}" class="muted">{{role.name}} · {{role.sourceText}} → {{role.targetNames}}</view><view class="actions"><button wx:if="{{member.id === currentId}}" class="ghost small" disabled="{{!member.active}}" data-id="{{item.vehicleId}}" bindtap="editAsset">编辑</button><button wx:if="{{canEditMember}}" class="danger small" data-asset="{{item.id}}" bindtap="removeAsset">移除</button></view></view><button wx:if="{{canEditMember}}" class="ghost" bindtap="addVehicle">+ 从资料库添加我的车辆</button>
      <view class="section-title">Token 当前持有量</view><view class="muted">仅填写当前实际持有数量，过去奖励不要重复计入。</view><view wx:for="{{memberTokens}}" wx:key="id"><view class="label">{{item.name}}</view><input type="number" value="{{item.quantity}}" data-id="{{item.id}}" disabled="{{!canEditMember}}" bindblur="token"/></view>
    </view><view wx:if="{{!members.length}}" class="empty">玩家使用稳定 ID，改名不会断开车辆关系。</view>
  </block>
  <block wx:if="{{tab === 'roles'}}">
    <button class="ghost" disabled="{{connected && !currentId}}" bindtap="newRole">+ 新建职责</button><view class="muted">拖动 ≡ 排序，或使用 ↑ / ↓ 调整。</view>
    <view wx:for="{{roles}}" wx:key="id" class="card role-sort {{draggingRole === item.id ? 'dragging' : ''}}"><view class="row"><view class="drag-handle" data-id="{{item.id}}" bindtouchstart="roleDragStart" catchtouchmove="roleDragMove" bindtouchend="roleDragEnd">≡</view><view><view class="card-title">{{item.name}}</view><view class="muted">{{item.description}}</view></view></view><view class="actions"><button class="ghost small" data-id="{{item.id}}" data-dir="-1" bindtap="moveRole">↑</button><button class="ghost small" data-id="{{item.id}}" data-dir="1" bindtap="moveRole">↓</button><button class="ghost small" data-id="{{item.id}}" bindtap="editRole">编辑</button><button class="danger small" data-id="{{item.id}}" bindtap="deleteRole">删除</button></view></view><view wx:if="{{!roles.length}}" class="empty">职责由团队自定义，例如抗线、侦察或步兵支援。</view>
  </block>
  <block wx:if="{{tab === 'plans'}}">
    <picker wx:if="{{members.length}}" range="{{members}}" range-key="name" value="{{memberIndex}}" bindchange="pickMember"><view class="picker">{{member.name}} ▾</view></picker>
    <view wx:if="{{!targets.length}}" class="empty">暂无正式计划目标。将车辆设为“计划”，并分配一个职责下的主力或备选，即可展开前置。</view>
    <view wx:for="{{targets}}" wx:key="id" class="card {{targetId === item.id ? 'player selected' : ''}}" data-id="{{item.id}}" bindtap="target"><view>{{item.name}}</view><view class="muted">{{item.roleName}} · {{item.levelText}}</view></view>
    <view wx:if="{{plan}}" class="card"><view class="card-title">目标获取路线</view><view class="warning">{{plan.status}} · 已拥有 {{plan.ownedCount}} / {{plan.count}} 个路线节点</view>
      <view wx:for="{{choices}}" wx:key="vehicleId"><view class="label">{{item.name}} · 请选择完整路线</view><picker range="{{item.paths}}" range-key="name" value="{{item.index}}" data-index="{{index}}" disabled="{{!canEditMember}}" bindchange="routeChoice"><view class="picker">选择获取路线 ▾</view></picker></view>
      <view wx:for="{{routeOptions}}" wx:key="vehicleId"><view class="label">{{item.name}} · 路线选择</view><picker range="{{item.paths}}" range-key="name" value="{{item.index}}" data-vehicle="{{item.vehicleId}}" disabled="{{!canEditMember}}" bindchange="pickRoute"><view class="picker">{{item.index >= 0 ? item.paths[item.index].name : '请选择'}} ▾</view></picker></view>
      <view wx:for="{{plan.steps}}" wx:key="id" wx:for-item="step" class="line"><view class="row between"><text data-id="{{step.id}}" bindtap="detail">{{step.owned ? '✓' : '○'}} {{step.name}} ›</text><text class="tag">{{step.owned ? '已拥有' : '计划'}}</text></view><view class="row between"><text class="muted">{{step.pathName}}</text><text class="link" data-id="{{step.id}}" bindtap="tree">查看科技树 ›</text></view><view wx:if="{{step.blocked}}" class="warning">路线在此处中断：Token 余额不足</view><view wx:for="{{step.changes}}" wx:key="*this" class="muted">{{item}}</view>
        <view wx:for="{{step.requirements}}" wx:key="id" class="row between"><text class="muted">{{item.description}}</text><switch wx:if="{{!step.owned && !item.token_id && item.requirement_type !== 'own_vehicle'}}" checked="{{item.confirmed}}" data-id="{{item.id}}" bindchange="confirmRequirement" disabled="{{!canEditMember}}" color="#1c1a1e"/></view>
        <view wx:for="{{step.rewards}}" wx:key="id"><view class="muted">{{item.tokenName}} ×{{item.quantity}} · {{item.description}}</view><view wx:if="{{!step.owned}}" class="row between"><text class="muted">已确认本节点完成时可领取</text><switch checked="{{item.confirmed}}" data-id="{{item.id}}" bindchange="confirmReward" disabled="{{!canEditMember}}" color="#1c1a1e"/></view><view wx:else="" class="muted">既有车辆奖励请计入当前持有量，不重复预计获取。</view></view>
      </view>
      <view wx:for="{{plan.warnings}}" wx:key="*this" class="muted">· {{item}}</view><view class="muted">条件开关仅表示你已核实可满足该条件，不会修改公开资料。</view>
    </view>
    <view wx:if="{{unionPlan}}" class="card"><view class="card-title">该玩家全部目标 · Token 合并检查</view><view class="warning">{{unionPlan.status}}</view><view class="muted">共享前置与奖励只计算一次；每种 Token 独立检查。</view><view wx:for="{{unionPlan.tokens}}" wx:key="id" class="line"><view>{{item.name}}</view><view class="muted">当前持有 {{item.owned}} + 确认获取 {{item.gained}} · 待确认获取 {{item.uncertain}}</view><view class="muted">消耗 {{item.consumed}} · 最终余额 {{item.final}}</view><view>总量：{{item.totalOk ? '✓ 满足严格大于规则' : '✕ 不满足严格大于规则'}}</view><view>过程：{{item.processOk ? '✓ 已知 Token 步骤可执行' : '✕ 中途余额不足'}}</view></view><view wx:if="{{!unionPlan.tokens.length}}" class="muted">所选已知路线暂无 Token 记录；路线不完整时仍无法确认。</view></view>
  </block>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{editVehicleId}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<block wx:if="{{memberForm || roleForm}}"><view class="form-backdrop" bindtap="cancelForm"></view><view class="form"><view class="card-title">{{memberForm ? '玩家信息' : '职责信息'}}</view><block wx:if="{{memberForm}}"><view class="label">显示名称</view><input value="{{memberForm.name}}" bindinput="memberName" maxlength="60"/></block><block wx:if="{{roleForm}}"><view class="label">职责名称</view><input value="{{roleForm.name}}" data-key="name" bindinput="roleField" maxlength="60"/><view class="label">说明</view><textarea value="{{roleForm.description}}" data-key="description" bindinput="roleField" maxlength="500"/></block><view class="actions"><button class="ghost" bindtap="cancelForm">取消</button><button wx:if="{{memberForm}}" class="primary" bindtap="saveMember">保存</button><button wx:else="" class="primary" bindtap="saveRole">保存</button></view></view></block>

<view class="module-footer"><text class="link" bindtap="awHome">‹ AW 模块入口</text></view>
