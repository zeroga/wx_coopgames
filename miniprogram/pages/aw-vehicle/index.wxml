<view class="aw-page" wx:if="{{vehicle}}">
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · VEHICLE</view><view class="title">{{vehicle.displayName}}</view><view class="subtitle">{{vehicle.is_legendary ? '传奇' : 'T' + vehicle.tier}} · {{vehicle.vehicle_class}} {{vehicle.is_premium ? '· Premium' : ''}}<view>{{vehicle.nation}} · {{vehicle.acquisitionText}}</view><view wx:if="{{vehicle.dealerName}}">{{vehicle.dealerName}}</view></view></view>
  <view><text wx:for="{{vehicle.capabilities}}" wx:key="id" wx:if="{{item.availability !== 'absent'}}" class="tag {{item.availability === 'unknown' ? 'warning' : ''}}">{{item.name}}{{item.availability === 'default' ? '' : ' · ' + item.statusText}}</text></view>
  <view class="card"><view class="card-title">核心性能</view><view class="metrics"><view wx:for="{{vehicle.core}}" wx:key="key" class="metric"><view class="muted">{{item.name}}</view><view class="value">{{item.value}}</view></view></view><view wx:if="{{!vehicle.core.length}}" class="muted">核心性能待补全</view>
    <view class="link" bindtap="basis">{{vehicle.basis}} ▾</view><view wx:if="{{showBasis}}"><view wx:for="{{vehicle.basisDetails}}" wx:key="name" class="muted">{{item.name}}：{{item.value}}</view></view>
    <view wx:if="{{vehicle.more.length}}" class="link" bindtap="more">{{showMore ? '收起' : '更多性能参数'}} ▾</view><view wx:if="{{showMore}}"><view wx:for="{{vehicle.more}}" wx:key="key" class="line row between"><text>{{item.name}}</text><text>{{item.value}}</text></view></view>
  </view>
  <view class="card"><view class="row between"><text class="card-title">车队状态</text><text class="link" bindtap="fleet">车队管理 ›</text></view>
    <view wx:for="{{team}}" wx:key="id" class="line"><view class="row between"><text>{{item.memberName}} · {{item.statusText}}</text><text class="link" data-member="{{item.memberId}}" bindtap="edit">编辑</text></view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:for-item="role" wx:key="id" wx:if="{{role.targetNames}}" class="muted">{{role.name}} → {{role.targetNames}} · {{role.sourceText}}</view><view wx:if="{{item.planText}}" class="link" data-member="{{item.memberId}}" data-target="{{item.planTargetId}}" data-plan="true" bindtap="fleet">{{item.planText}} ›</view></view>
    <view wx:if="{{!team.length}}" class="muted">暂无玩家车辆记录</view><view wx:if="{{extra}}" class="link" bindtap="allTeam">+{{extra}} 条记录 · 查看全部</view><button class="ghost" bindtap="edit">编辑车队状态</button>
  </view>
  <view class="section-title">武器配置</view><view wx:if="{{!vehicle.configs.length}}" class="card muted">武器资料待补全</view>
  <view class="tabs"><text wx:for="{{vehicle.configs}}" wx:key="key" class="tag {{configIndex === index ? 'selected' : ''}}" data-index="{{index}}" bindtap="config">{{item.name}}</text></view>
  <view wx:for="{{vehicle.configs[configIndex].weapons}}" wx:key="id" class="card" wx:for-item="weapon">
    <view class="card-title">{{weapon.name}}</view><view class="muted">{{weapon.typeText}} · {{weapon.quality}}</view><view><text wx:for="{{weapon.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view>
    <view wx:if="{{weapon.note}}" class="muted">{{weapon.note}}</view><view class="link" data-id="{{weapon.id}}" bindtap="weapon">{{expandedWeapons[weapon.id] ? '收起弹药' : '查看 ' + weapon.ammo.length + ' 种弹药与参数'}} ▾</view>
    <view wx:if="{{expandedWeapons[weapon.id]}}"><view wx:for="{{weapon.ammo}}" wx:for-item="ammo" wx:key="id" class="ammo"><view>{{ammo.name}}</view><view class="muted">{{ammo.ammo_type}} · {{ammo.availabilityText}} · {{ammo.quality}}</view><text wx:for="{{ammo.tagNames}}" wx:key="*this" class="tag">{{item}}</text><view class="metrics"><view wx:for="{{ammo.params}}" wx:key="key"><view class="muted">{{item.name}}</view><view>{{item.value}}</view></view></view><view wx:for="{{ammo.guidance}}" wx:key="*this" class="muted">{{item}}</view><view wx:if="{{ammo.note}}" class="muted">{{ammo.note}}</view><view class="link" data-url="{{ammo.source_url}}" bindtap="source">复制弹药来源链接</view></view><view wx:if="{{!weapon.ammo.length}}" class="muted">弹药资料待补全</view></view>
  </view>
  <view class="card"><view class="row between"><view class="card-title">防护与特殊能力</view><text class="link" bindtap="abilities">{{showAbilities ? '收起' : '展开说明'}} ▾</text></view><block wx:if="{{showAbilities}}"><view wx:for="{{vehicle.capabilities}}" wx:key="id" class="line"><view>{{item.name}} <text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.effect_description}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text><view wx:if="{{item.era.length}}" class="muted">ERA 覆盖资料缺失时不生成覆盖图。</view><view class="link" data-url="{{item.source_url}}" bindtap="source">复制能力来源链接</view></view><view wx:if="{{!vehicle.capabilities.length}}" class="muted">能力资料待补全，不能据此判断不存在。</view></block><view wx:if="{{!showAbilities}}" class="muted">{{vehicle.capabilities.length}} 项能力 · 已知能力显示在页首，展开查看效果及核验状态。</view></view>
  <view class="card"><view class="card-title">研发与配件</view><view wx:for="{{vehicle.upgradeGroups}}" wx:key="name" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.items}}" wx:key="id" class="line"><view>{{item.name}}</view><view class="muted">{{item.effect_description}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text><view class="muted">{{item.quality}}</view></view></view><view wx:if="{{!vehicle.upgradeGroups.length}}" class="muted">配件资料待补全</view></view>
  <view class="card"><view class="row between"><text class="card-title">获取与科技树</text><text class="link" bindtap="tree">定位科技树 ›</text></view><view class="muted">{{vehicle.acquisitionText}} {{vehicle.acquisition_note}}</view><view wx:for="{{vehicle.paths}}" wx:key="id" class="line"><view>{{item.name}} <text wx:if="{{!item.is_complete}}" class="tag warning">路线待补全</text></view><view wx:for="{{item.requirements}}" wx:key="id" class="muted">{{item.description}}</view><view class="muted">{{item.note}}</view></view><view wx:for="{{vehicle.rewards}}" wx:key="id" class="line"><view>产生 {{item.tokenName}} ×{{item.quantity}}</view><view class="muted">{{item.description}} · 不自动计入持有量</view></view><button class="ghost" data-plan="true" bindtap="fleet">查看获取规划与 Token 检查</button></view>
  <view wx:if="{{vehicle.armor.length}}" class="card"><view class="card-title">装甲资料</view><view wx:for="{{vehicle.armor}}" wx:key="id" class="line"><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view></view>
  <view class="card"><view class="row between"><view class="card-title">来源与核验状态</view><text class="link" bindtap="sources">{{showSources ? '收起' : '展开'}} ▾</text></view><block wx:if="{{showSources}}"><view class="muted">{{vehicle.quality}}</view><view class="muted">{{vehicle.source_note}}</view><view class="muted">最近核对：{{vehicle.last_checked_at}}</view><view class="link" data-url="{{vehicle.source_url}}" bindtap="source">复制来源链接</view></block></view>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{id}}" member-id="{{editMemberId}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<view wx:else="" class="empty">未找到车辆资料，请返回资料库。</view>
