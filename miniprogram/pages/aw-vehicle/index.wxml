<view class="aw-page" wx:if="{{vehicle}}">
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · VEHICLE</view><view class="title">{{vehicle.displayName}}</view><view class="subtitle">{{vehicle.is_legendary ? '传奇' : 'T' + vehicle.tier}} · {{vehicle.vehicle_class}} {{vehicle.is_premium ? '· Premium' : ''}}<view>{{vehicle.nation}} · {{vehicle.acquisitionText}}</view><view wx:if="{{vehicle.dealerName}}">{{vehicle.dealerName}}</view><view><text wx:for="{{vehicle.capabilities}}" wx:key="id" wx:if="{{item.availability !== 'absent'}}" class="tag {{item.availability === 'unknown' ? 'warning' : ''}}">{{item.name}}{{item.availability === 'default' ? '' : ' · ' + item.statusText}}</text></view></view></view>
  <view class="card"><view class="section-head" data-section="performance" bindtap="section"><text class="card-title">核心性能</text><text class="fold">{{sections.performance ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.performance}}">
    <view class="metrics"><view wx:for="{{vehicle.core}}" wx:key="key" class="metric"><view class="muted">{{item.name}}</view><view class="value">{{item.value}}</view></view></view><view wx:if="{{!vehicle.core.length}}" class="muted">核心性能待补全</view>
    <view class="link" bindtap="basis">{{vehicle.basis}} {{showBasis ? '∧' : '∨'}}</view><view wx:if="{{showBasis}}"><view wx:for="{{vehicle.basisDetails}}" wx:key="name" class="muted">{{item.name}}：{{item.value}}</view></view>
    <view wx:if="{{vehicle.more.length}}" class="link" bindtap="more">{{showMore ? '收起更多参数 ∧' : '更多性能参数 ∨'}}</view><view wx:if="{{showMore}}"><view wx:for="{{vehicle.more}}" wx:key="key" class="line row between"><text>{{item.name}}</text><text>{{item.value}}</text></view></view>
  </block></view>
  <view class="card"><view class="card-title">车队状态</view>
    <view wx:for="{{team}}" wx:key="id" class="line"><view>{{item.memberName}} · {{item.statusText}}</view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:for-item="role" wx:key="id" wx:if="{{role.targetNames}}" class="muted">{{role.name}} → {{role.targetNames}} · {{role.sourceText}}</view><view wx:if="{{item.planText}}" class="link" data-member="{{item.memberId}}" data-target="{{item.planTargetId}}" data-plan="true" bindtap="fleet">查看 {{item.memberName}} 的获取规划 ›</view></view>
    <view wx:if="{{!team.length}}" class="muted">暂无车辆记录</view><view wx:if="{{extra}}" class="link" bindtap="allTeam">+{{extra}} 条记录 · 查看全部</view><button class="ghost" bindtap="edit">登记我的车辆与职责</button><view class="link" bindtap="fleet">前往车队管理 ›</view>
  </view>
  <view class="card"><view class="section-head" data-section="weapons" bindtap="section"><text class="card-title">武器与弹药</text><text class="fold">{{sections.weapons ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.weapons}}">
    <view wx:if="{{!vehicle.weaponGroups.length}}" class="muted">武器资料待补全</view>
    <view wx:for="{{vehicle.weaponGroups}}" wx:key="id" wx:for-item="group" class="weapon-group {{group.exclusive ? 'exclusive' : ''}}">
      <view wx:if="{{group.exclusive}}" class="exclusive-label">{{group.label}}</view>
      <view wx:for="{{group.weapons}}" wx:key="id" wx:for-item="weapon" class="weapon-card">
        <view class="weapon-head"><view class="weapon-name">{{weapon.name}}</view><view wx:if="{{weapon.configurationText}}" class="muted">{{weapon.configurationText}}</view></view>
        <view class="label">弹药</view>
        <view wx:for="{{weapon.ammo}}" wx:for-item="ammo" wx:key="id" class="ammo ammo-{{ammo.colorClass}}">
          <view class="ammo-title" data-id="{{ammo.id}}" bindtap="ammo"><text class="ammo-type">{{ammo.typeLabel}}</text><text class="ammo-name {{expandedAmmo[ammo.id] ? 'expanded' : ''}}">{{ammo.name}}</text><text class="ammo-arrow">{{expandedAmmo[ammo.id] ? '∧' : '∨'}}</text></view>
          <view wx:if="{{expandedAmmo[ammo.id]}}" class="ammo-details"><view class="muted">{{ammo.availabilityText}} · {{ammo.quality}}</view><text wx:for="{{ammo.tagNames}}" wx:key="*this" class="tag">{{item}}</text><view class="metrics"><view wx:for="{{ammo.params}}" wx:key="key"><view class="muted">{{item.name}}</view><view>{{item.value}}</view></view></view><view wx:for="{{ammo.guidance}}" wx:key="*this" class="muted">{{item}}</view><view wx:if="{{ammo.note}}" class="muted">{{ammo.note}}</view><view wx:if="{{ammo.source_url}}" class="link" data-url="{{ammo.source_url}}" bindtap="source">复制弹药来源链接</view></view>
        </view><view wx:if="{{!weapon.ammo.length}}" class="muted">弹药资料待补全</view>
        <view class="label">武器说明</view><view class="muted">{{weapon.typeText}} · {{weapon.quality}}</view><view><text wx:for="{{weapon.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view><view wx:if="{{weapon.note}}" class="muted">{{weapon.note}}</view>
      </view>
    </view>
  </block></view>
  <view class="card"><view class="section-head" data-section="abilities" bindtap="section"><text class="card-title">防护与特殊能力</text><text class="fold">{{sections.abilities ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.abilities}}"><view wx:for="{{vehicle.capabilities}}" wx:key="id" class="line"><view>{{item.name}} <text class="tag">{{item.statusText}}</text></view><view class="muted">{{item.effect_description}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text><view wx:if="{{item.era.length}}" class="muted">ERA 覆盖资料缺失时不生成覆盖图。</view><view wx:if="{{item.source_url}}" class="link" data-url="{{item.source_url}}" bindtap="source">复制能力来源链接</view></view><view wx:if="{{!vehicle.capabilities.length}}" class="muted">能力资料待补全，不能据此判断不存在。</view></block></view>
  <view class="card"><view class="section-head" data-section="upgrades" bindtap="section"><text class="card-title">研发与配件</text><text class="fold">{{sections.upgrades ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.upgrades}}"><view wx:for="{{vehicle.upgradeGroups}}" wx:key="name" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.items}}" wx:key="id" class="line"><view>{{item.name}}</view><view class="muted">{{item.effect_description}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text><view class="muted">{{item.quality}}</view></view></view><view wx:if="{{!vehicle.upgradeGroups.length}}" class="muted">配件资料待补全</view></block></view>
  <view class="card"><view class="section-head" data-section="acquisition" bindtap="section"><text class="card-title">获取与科技树</text><text class="fold">{{sections.acquisition ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.acquisition}}"><view class="muted">{{vehicle.acquisitionText}} {{vehicle.acquisition_note}}</view><view wx:for="{{vehicle.paths}}" wx:key="id" class="line"><view>{{item.name}} <text wx:if="{{!item.is_complete}}" class="tag warning">路线待补全</text></view><view wx:for="{{item.requirements}}" wx:key="id" class="muted">{{item.description}}</view><view class="muted">{{item.note}}</view></view><view wx:for="{{vehicle.rewards}}" wx:key="id" class="line"><view>产生 {{item.tokenName}} ×{{item.quantity}}</view><view class="muted">{{item.description}} · 不自动计入持有量</view></view><view class="page-entry" bindtap="tree"><text>查看完整科技树与获取条件</text><text>›</text></view><view class="page-entry" data-plan="true" bindtap="fleet"><text>前往车队获取规划与 Token 检查</text><text>›</text></view></block></view>
  <view class="card"><view class="section-head" data-section="armor" bindtap="section"><text class="card-title">装甲资料</text><text class="fold">{{sections.armor ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.armor}}"><view wx:for="{{vehicle.armor}}" wx:key="id" class="line"><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view><view wx:if="{{!vehicle.armor.length}}" class="muted">装甲资料待补全</view></block></view>
  <view class="card"><view class="section-head" data-section="sources" bindtap="section"><text class="card-title">来源与核验状态</text><text class="fold">{{sections.sources ? '收起 ∧' : '展开 ∨'}}</text></view><block wx:if="{{sections.sources}}"><view class="muted">{{vehicle.quality}}</view><view class="muted">{{vehicle.source_note}}</view><view class="muted">最近核对：{{vehicle.last_checked_at}}</view><view wx:if="{{vehicle.source_url}}" class="link" data-url="{{vehicle.source_url}}" bindtap="source">复制来源链接</view></block></view>
  <view class="vehicle-actions"><button class="primary" bindtap="edit">登记我的车辆与职责</button></view>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{id}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<view wx:else="" class="empty">未找到车辆资料，请返回资料库。</view>
