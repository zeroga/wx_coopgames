<page-meta page-style="{{editor || prerequisiteForm ? 'overflow:hidden;' : ''}}"/>
<view class="aw-page" wx:if="{{vehicle}}">
  <view wx:if="{{syncError}}" class="ui-error">{{syncError}}</view>
  <view class="hero"><view class="eyebrow">ARMORED WARFARE · VEHICLE</view><view class="title"><aw-vehicle-label vehicle-id="{{vehicle.id}}" catalog-revision="{{catalogRevision}}" variant="hero"/></view><view class="subtitle"><text wx:if="{{vehicle.is_premium}}" class="tag">Premium</text><text class="tag">{{vehicle.acquisitionText}}</text><view><text wx:for="{{vehicle.capabilities}}" wx:key="id" wx:if="{{item.availability !== 'absent'}}" class="tag">{{item.name}}{{item.availability !== 'default' && item.statusText ? ' · ' + item.statusText : ''}}</text></view></view></view>
  <view class="ui-card card"><view class="section-head" data-section="performance" bindtap="section"><text class="card-title">核心性能</text><view class="fold"><text>{{sections.performance ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.performance ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.performance}}">
    <view class="metrics"><view wx:for="{{vehicle.core}}" wx:key="key" class="metric"><view class="muted">{{item.name}}</view><view class="value">{{item.value}}</view></view></view><view wx:if="{{!vehicle.core.length}}" class="muted">核心性能待补全</view>
    <view class="link fold-link" bindtap="basis">{{vehicle.basis}} <image class="inline-chevron" src="/assets/icons/{{showBasis ? 'chevron-up' : 'chevron-down'}}.svg"/></view><view wx:if="{{showBasis}}"><view wx:for="{{vehicle.basisDetails}}" wx:key="name" class="muted">{{item.name}}：{{item.value}}</view></view>
    <view wx:if="{{vehicle.more.length}}" class="link fold-link" bindtap="more">{{showMore ? '收起更多参数' : '更多性能参数'}} <image class="inline-chevron" src="/assets/icons/{{showMore ? 'chevron-up' : 'chevron-down'}}.svg"/></view><view wx:if="{{showMore}}"><view wx:for="{{vehicle.more}}" wx:key="key" class="line row between"><text>{{item.name}}</text><text>{{item.value}}</text></view></view>
  </block></view>
  <view class="ui-card card"><view class="card-title">车队状态</view>
    <view wx:for="{{team}}" wx:key="id" class="line"><view class="row between"><text>{{item.memberName}} · {{item.statusText}}</text><button wx:if="{{item.status === 'planned'}}" class="ui-button {{item.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" data-member="{{item.memberId}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{item.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button></view><view wx:if="{{item.customPrerequisite}}" class="custom-prerequisite">自定义前置</view><view class="muted">{{item.roleText}}</view><view wx:for="{{item.roles}}" wx:for-item="role" wx:key="id" wx:if="{{role.targetNames}}" class="muted"><view>{{role.name}} · {{role.sourceText}} →</view><view wx:for="{{role.targetVehicles}}" wx:key="id" wx:for-item="target" class="ui-card vehicle-card target-vehicle"><aw-vehicle-label vehicle-id="{{target.id}}" name="{{target.name}}" catalog-revision="{{catalogRevision}}"/></view></view><view wx:if="{{item.planText}}" class="link" data-member="{{item.memberId}}" data-target="{{item.planTargetId}}" data-plan="true" bindtap="fleet">查看 {{item.memberName}} 的获取规划 <image class="inline-chevron" src="/assets/icons/chevron-right.svg"/></view></view>
    <view wx:if="{{!team.length}}" class="muted">暂无车辆记录</view><view wx:if="{{extra}}" class="link" bindtap="allTeam">+{{extra}} 条记录 · 查看全部</view><button class="ui-button ghost" bindtap="edit">登记我的车辆与职责</button><view class="link" bindtap="fleet">前往车队管理 <image class="inline-chevron" src="/assets/icons/chevron-right.svg"/></view>
  </view>
  <view class="ui-card card"><view class="section-head" data-section="weapons" bindtap="section"><text class="card-title">武器与弹药</text><view class="fold"><text>{{sections.weapons ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.weapons ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.weapons}}">
    <view wx:if="{{!vehicle.weaponGroups.length}}" class="muted">武器资料待补全</view>
    <view wx:for="{{vehicle.weaponGroups}}" wx:key="id" wx:for-item="group" class="weapon-group {{group.exclusive ? 'exclusive' : ''}}">
      <view wx:if="{{group.exclusive}}" class="exclusive-label">{{group.label}}</view>
      <view wx:for="{{group.weapons}}" wx:key="id" wx:for-item="weapon" class="weapon-card">
        <view class="weapon-head"><view class="weapon-name">{{weapon.name}}</view></view>
        <view class="label">弹药</view>
        <view wx:for="{{weapon.ammo}}" wx:for-item="ammo" wx:key="id" class="ammo ammo-{{ammo.colorClass}}">
          <view class="ammo-title" data-id="{{ammo.id}}" bindtap="ammo"><text class="ammo-type">{{ammo.typeLabel}}{{ammo.warheadLabel ? ' · ' + ammo.warheadLabel : ''}}</text><text class="ammo-name {{expandedAmmo[ammo.id] ? 'expanded' : ''}}">{{ammo.name}}</text><image class="ammo-arrow" src="/assets/icons/{{expandedAmmo[ammo.id] ? 'chevron-up' : 'chevron-down'}}.svg"/></view>
          <view wx:if="{{expandedAmmo[ammo.id]}}" class="ammo-details"><view wx:if="{{ammo.availabilityText}}" class="muted">{{ammo.availabilityText}}</view><text wx:for="{{ammo.tagNames}}" wx:key="*this" class="tag">{{item}}</text><view class="metrics"><view wx:for="{{ammo.params}}" wx:key="key"><view class="muted">{{item.name}}</view><view>{{item.value}}</view></view></view><view wx:for="{{ammo.guidance}}" wx:key="*this" class="muted">{{item}}</view><view wx:if="{{ammo.classification.source_url}}" class="link" data-url="{{ammo.classification.source_url}}" bindtap="source">复制弹头分类来源</view><view wx:if="{{ammo.source_url}}" class="link" data-url="{{ammo.source_url}}" bindtap="source">复制弹药来源链接</view></view>
        </view><view wx:if="{{!weapon.ammo.length}}" class="muted">弹药资料待补全</view>
        <view class="label">武器说明</view><view class="muted">{{weapon.typeText}}</view><view><text wx:for="{{weapon.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view>
      </view>
    </view>
  </block></view>
  <view class="ui-card card"><view class="section-head" data-section="abilities" bindtap="section"><text class="card-title">防护与特殊能力</text><view class="fold"><text>{{sections.abilities ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.abilities ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.abilities}}"><view wx:for="{{vehicle.capabilities}}" wx:key="id" class="line"><view>{{item.name}} <text wx:if="{{item.statusText}}" class="tag">{{item.statusText}}</text></view><view wx:if="{{item.displayDescription}}" class="muted">{{item.displayDescription}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text><view wx:if="{{item.era.length}}" class="muted">ERA 覆盖资料缺失时不生成覆盖图。</view><view wx:if="{{item.source_url}}" class="link" data-url="{{item.source_url}}" bindtap="source">复制能力来源链接</view></view><view wx:if="{{!vehicle.capabilities.length}}" class="muted">能力资料待补全，不能据此判断不存在。</view></block></view>
  <view class="ui-card card"><view class="section-head" data-section="upgrades" bindtap="section"><text class="card-title">研发与配件</text><view class="fold"><text>{{sections.upgrades ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.upgrades ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.upgrades}}"><view wx:for="{{vehicle.upgradeGroups}}" wx:key="name" wx:for-item="group"><view class="label">{{group.name}}</view><view wx:for="{{group.items}}" wx:key="id" class="line"><view>{{item.name}}</view><view wx:if="{{item.displayDescription}}" class="muted">{{item.displayDescription}}</view><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view></view><view wx:if="{{!vehicle.upgradeGroups.length}}" class="muted">配件资料待补全</view></block></view>
  <view class="ui-card card"><view class="section-head" data-section="acquisition" bindtap="section"><text class="card-title">获取与科技树</text><view class="fold"><text>{{sections.acquisition ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.acquisition ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.acquisition}}"><view class="muted">{{vehicle.acquisitionText}}</view><view class="row"><button class="ui-button {{prerequisite.needsPrerequisite ? 'prerequisite-alert' : 'quiet-control'}}" bindtap="configurePrerequisites" aria-label="前置与 Token 配置"><image wx:if="{{prerequisite.needsPrerequisite}}" class="prerequisite-icon" src="/assets/icons/warning.svg"/><text wx:else="">前置配置</text></button><text wx:if="{{prerequisite.needsPrerequisite}}" class="muted">需要前置</text><text wx:if="{{prerequisite.customPrerequisite}}" class="custom-prerequisite">自定义前置</text></view><view wx:for="{{vehicle.rewards}}" wx:key="id" class="line"><view>产生 {{item.tokenName}} ×{{item.quantity}}</view><view class="muted">{{item.description}} · 不自动计入持有量</view></view><view class="page-entry" bindtap="tree"><text>查看完整科技树与获取条件</text><image class="entry-chevron" src="/assets/icons/chevron-right.svg"/></view><view class="page-entry" data-plan="true" bindtap="fleet"><text>前往车队获取规划与 Token 检查</text><image class="entry-chevron" src="/assets/icons/chevron-right.svg"/></view></block></view>
  <view class="ui-card card"><view class="section-head" data-section="armor" bindtap="section"><text class="card-title">装甲资料</text><view class="fold"><text>{{sections.armor ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.armor ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.armor}}"><view wx:for="{{vehicle.armor}}" wx:key="id" class="line"><text wx:for="{{item.params}}" wx:key="key" class="param">{{item.name}} {{item.value}}</text></view><view wx:if="{{!vehicle.armor.length}}" class="muted">装甲资料待补全</view></block></view>
  <view class="ui-card card"><view class="section-head" data-section="sources" bindtap="section"><text class="card-title">资料来源</text><view class="fold"><text>{{sections.sources ? '收起' : '展开'}}</text><image class="fold-icon" src="/assets/icons/{{sections.sources ? 'chevron-up' : 'chevron-down'}}.svg"/></view></view><block wx:if="{{sections.sources}}"><view wx:if="{{vehicle.source_url}}" class="link" data-url="{{vehicle.source_url}}" bindtap="source">复制来源链接</view></block></view>
  <view class="vehicle-actions"><button class="ui-button primary" bindtap="edit">登记我的车辆与职责</button></view>
  <aw-asset-editor wx:if="{{editor}}" vehicle-id="{{id}}" bind:saved="saved" bind:cancel="cancel"/>
</view>
<view wx:else="" class="aw-page"><view class="ui-card card empty">未找到车辆资料，请返回资料库。</view></view>

<aw-prerequisites wx:if="{{prerequisiteForm}}" vehicle-id="{{prerequisiteForm.vehicleId}}" member-id="{{prerequisiteForm.memberId}}" bind:saved="prerequisitesSaved" bind:cancel="closePrerequisites"/>
