page{background:#f1f0f2;color:#1c1a1e;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}.btn{border:0;border-radius:14rpx;font-size:26rpx;line-height:1;padding:22rpx 26rpx}.btn::after{border:0}.btn-primary{background:#1c1a1e;color:#fff}.btn-ghost{background:#fff;color:#1c1a1e;border:1rpx solid rgba(28,26,30,.12)}.muted{color:#6b6370}.mono{font-variant-numeric:tabular-nums}.card{background:#fbfafc;border:1rpx solid rgba(28,26,30,.12);border-radius:22rpx;box-shadow:0 8rpx 26rpx rgba(28,26,30,.05)}