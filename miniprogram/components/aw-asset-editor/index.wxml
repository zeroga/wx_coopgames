<view class="backdrop" catchtap="cancel"></view>
<view class="sheet">
  <view class="sheet-head"><view><view class="card-title">登记我的车辆与职责</view><view class="muted">{{vehicleName}}</view></view></view>
  <scroll-view scroll-y="{{true}}" class="sheet-content">
    <block wx:if="{{!members.length || !editable}}">
      <view class="empty">{{members.length ? '关联自己的成员码后，可以登记车辆。' : '先建立自己的成员档，再登记车辆。'}}</view>
      <block wx:if="{{!members.length}}"><view class="label">我的名字</view><input class="field" value="{{identityName}}" data-key="identityName" bindinput="identityField" maxlength="60" placeholder="填写自己的名字"/><button class="btn ghost" disabled="{{identityBusy}}" bindtap="createSelf">建立我的成员档</button></block>
      <view class="label">使用已有成员档</view><input class="field" value="{{memberCode}}" data-key="memberCode" bindinput="identityField" maxlength="37" placeholder="AW-M-我的成员码"/><button class="btn ghost" disabled="{{identityBusy}}" bindtap="associateSelf">关联我的成员码</button>
    </block>
    <block wx:else="">
      <view class="muted">我的成员档 · {{members[0].name}}</view>
      <view class="label">车辆状态</view><picker range="{{statuses}}" value="{{statusIndex}}" bindchange="pickStatus"><view class="picker">{{statuses[statusIndex]}} ▾</view></picker>
      <view class="row between"><view class="label">车辆职责 · 可多选</view><text class="link" bindtap="roleManager">{{showRoleManager ? '收起管理 ∧' : '管理职责 ∨'}}</text></view>
      <view class="tags"><text wx:for="{{rows}}" wx:key="id" class="tag {{item.index ? 'selected' : ''}}" data-index="{{index}}" bindtap="toggleRole">{{item.index ? '✓ ' : '+ '}}{{item.name}}</text></view>
      <view wx:if="{{!rows.length}}" class="muted">还没有职责，可在“管理职责”中添加，也可以只保存车辆状态。</view>
      <view wx:if="{{showRoleManager}}" class="role-manager"><view class="muted">点标签编辑职责；职责变更单独保存。</view><view class="tags"><text wx:for="{{rows}}" wx:key="id" class="tag" data-id="{{item.id}}" bindtap="editRole">{{item.name}} · 编辑</text><text class="tag" bindtap="newRole">+ 新增职责</text></view>
        <view wx:if="{{roleForm}}"><input class="field" value="{{roleForm.name}}" data-key="name" bindinput="roleField" maxlength="60" placeholder="职责名称"/><input class="field" value="{{roleForm.description}}" data-key="description" bindinput="roleField" maxlength="500" placeholder="职责说明（可选）"/><view class="actions"><button class="btn ghost" bindtap="cancelRole">取消</button><button class="btn primary" bindtap="saveRole">保存职责</button><button wx:if="{{roleForm.id}}" class="btn danger" data-id="{{roleForm.id}}" bindtap="deleteRole">删除</button></view></view>
      </view>
      <view wx:for="{{rows}}" wx:key="id" wx:if="{{item.index || item.automatic}}" class="line">
        <view class="role-name">{{item.name}}</view><picker range="{{levels}}" value="{{item.index}}" data-index="{{index}}" bindchange="pickLevel"><view class="picker">{{levels[item.index]}} ▾</view></picker>
        <view wx:if="{{item.automatic}}" class="muted">科技树自动过渡由目标路线维护。</view>
        <checkbox-group wx:if="{{item.index === 3}}" data-index="{{index}}" bindchange="pickTargets"><view class="label">过渡服务的目标 · 可多选</view><label wx:for="{{item.targets}}" wx:for-item="target" wx:key="id" class="target"><checkbox value="{{target.id}}" checked="{{target.checked}}" color="#1c1a1e"/>{{target.name}}</label><view wx:if="{{!item.targets.length}}" class="muted">先为自己在同职责下登记主力或备选目标。</view></checkbox-group>
      </view>
      <view class="label">备注</view><textarea class="field notes" value="{{note}}" bindinput="note" maxlength="1000" placeholder="我的车辆备注"/>
    </block>
  </scroll-view>
  <view class="actions"><button class="btn ghost" bindtap="cancel">取消</button><button class="btn primary {{!members.length || !editable ? 'is-disabled' : ''}}" disabled="{{!members.length || !editable}}" bindtap="save">保存</button></view>
</view>
