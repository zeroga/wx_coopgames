.backdrop{position:fixed;inset:0;background:rgba(20,24,28,.4);z-index:80}.sheet{position:fixed;left:0;right:0;bottom:0;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 30rpx calc(24rpx + env(safe-area-inset-bottom));z-index:81;box-sizing:border-box}.head{display:flex;justify-content:space-between;align-items:center;gap:18rpx;margin-bottom:20rpx}.title{font-size:34rpx;font-weight:700}.muted{font-size:25rpx;color:#727b85;line-height:1.6}.content{box-sizing:border-box}.label{font-size:27rpx;font-weight:600;margin:28rpx 0 16rpx}.choice,.route,.ghost,.primary{font-size:28rpx;line-height:1.5;min-height:88rpx;padding:18rpx 22rpx;border-radius:16rpx;box-sizing:border-box}.choice,.route{background:#eef0f2;color:#4a535d;margin:12rpx 0}.choice{display:inline-block;margin-right:12rpx}.route{text-align:left;width:100%}.active{background:#ea7428;color:#fff;border:2rpx solid #ea7428}.ghost{background:#eef0f2;color:#4a535d;margin:16rpx 0}.small{min-height:88rpx;padding:12rpx 18rpx;margin:0;flex-shrink:0}.primary{background:#ea7428;color:#fff;width:100%}.footer{padding-top:18rpx}.note{margin:12rpx 0}.error{background:#fff1df;color:#805619;padding:18rpx;border-radius:12rpx;margin-bottom:14rpx}.custom-tag{display:inline-block;color:#6b5795;background:#f1ecf7;font-size:24rpx;border-radius:8rpx;padding:6rpx 14rpx}.search{font-size:28rpx;padding:20rpx;background:#f3f4f5;border-radius:14rpx;margin:18rpx 0}.choice::after,.route::after,.ghost::after,.primary::after{border:0}

.active .muted{color:#fff3e9}
