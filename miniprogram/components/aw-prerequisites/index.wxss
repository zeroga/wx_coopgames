/* Widths on button elements are inline: native style-v2 button selectors
   otherwise override a single class width and center 184px-wide controls. */
.backdrop { position:fixed; top:0; right:0; bottom:0; left:0; background:rgba(28,26,30,.45); z-index:80; }
.sheet { position:fixed; left:0; right:0; bottom:0; background:#fbfafc; color:#1c1a1e; border-radius:24rpx 24rpx 0 0; padding:26rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); z-index:81; box-sizing:border-box; }
.head { display:flex; justify-content:space-between; align-items:center; gap:12rpx; margin-bottom:18rpx; }
.head-main { flex:1; min-width:0; }
.panel-title { font-size:28rpx; font-weight:800; line-height:1.5; }
.muted { font-size:23rpx; color:#6b6370; line-height:1.6; }
.content { box-sizing:border-box; }
.label { font-size:26rpx; font-weight:700; margin:26rpx 0 12rpx; }
.choice,.route,.ghost,.primary { display:block; width:100%; margin:12rpx 0; font-size:26rpx; line-height:1; padding:18rpx 20rpx; border:1rpx solid #dedbe0; border-radius:14rpx; box-sizing:border-box; text-align:left; }
.choice,.route,.ghost { background:#f1f0f2; color:#1c1a1e; }
.active { background:#fff2df; border-color:#ea7428; }
.choice.active { background:#ea7428; color:#fff; }
.ghost { background:#fbfafc; }
.cancel-control { flex:none; width:auto; padding:8rpx 12rpx; margin:0; border:0; background:transparent; color:#6b6370; font-size:23rpx; line-height:1; }
.small { width:auto; padding:12rpx 18rpx; margin:0; }
.primary { background:#1c1a1e; color:#fff; text-align:center; }
.footer { padding-top:12rpx; }
.footer .ghost { text-align:center; }
.footer .primary,.footer .ghost { margin:0; }
.note { margin:10rpx 0; }
.error { background:#fff2df; color:#946126; padding:18rpx; border-radius:12rpx; margin-bottom:14rpx; }
.custom-tag { display:inline-block; color:#6b5795; background:#f1ecf7; font-size:23rpx; border-radius:8rpx; padding:6rpx 14rpx; }
.search { display:block; width:100%; box-sizing:border-box; font-size:26rpx; min-height:88rpx; padding:18rpx; background:#f1f0f2; border-radius:14rpx; margin:18rpx 0; }
.choice::after,.route::after,.ghost::after,.primary::after,.cancel-control::after { border:0; }
.choice[disabled],.route[disabled],.ghost[disabled],.primary[disabled],.cancel-control[disabled] { opacity:.45; }
.choice-heading { display:flex; align-items:center; gap:12rpx; min-width:0; }
.selection-mark { flex:none; width:24rpx; font-size:25rpx; color:#a94d16; text-align:right; line-height:1.4; }
@import "../../utils/aw/vehicle-card.wxss";
.vehicle-card::after { border:0; }
.vehicle-card[disabled] { opacity:.45; }
.vehicle-route { padding:0; border:0; background:transparent; }
.vehicle-route .vehicle-card { margin:0 0 18rpx; }
.vehicle-route.active .vehicle-card { border-color:#ea7428; background:#fff2df; }
.route-note { padding:0 20rpx 12rpx; }
.route-summary { font-size:26rpx; }
.current-vehicle { margin:0 0 18rpx; }

@import "../../utils/ui/components.wxss";

.sheet { display:flex; flex-direction:column; }
.head,.current-vehicle,.footer { flex:none; }
.content { flex:0 1 auto; min-height:0; }
