<view class="backdrop" catchtap="cancel"></view>
<view class="sheet" style="bottom:{{keyboardHeight}}px;max-height:calc(100vh - {{keyboardHeight}}px)">
  <view class="head"><view class="head-main"><view class="panel-title">{{stage === 'custom' ? '自定义前置' : '前置与 Token 配置'}}</view><view wx:if="{{stage === 'custom'}}" class="muted">从所有车辆中选择</view></view><button style="width:auto;max-width:none;margin:0" class="ui-button ui-compact cancel-control" disabled="{{saving}}" bindtap="cancel">取消</button></view>
  <view class="ui-card vehicle-card current-vehicle"><aw-vehicle-label vehicle-id="{{vehicleId}}" name="{{name}}" catalog-revision="{{catalogRevision}}"/></view>
  <scroll-view class="content" scroll-y="{{true}}" style="height:{{contentHeight}}px">
    <view wx:if="{{error}}" class="ui-error">{{error}}</view><view wx:if="{{syncError}}" class="ui-error">{{syncError}}</view><view wx:if="{{!editable}}" class="ui-card vehicle-card muted">队友的前置配置仅供查看。</view>
    <block wx:if="{{stage === 'known'}}">
      <button style="width:100%;max-width:none;margin-left:0;margin-right:0" class="ui-button choice {{draft.mode === 'ignore' ? 'active' : ''}}" disabled="{{saving || !editable}}" bindtap="ignore">无视前置</button>
      <view class="ui-card vehicle-card muted note">选择无视前置后，黄色感叹号会保留。</view>
      <view class="label">数据已知的前置 / Token 路线</view>
      <button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:for="{{options}}" wx:key="id" class="ui-button route vehicle-route {{draft.mode !== 'ignore' && draft.pathId === item.id ? 'active' : ''}}" data-id="{{item.id}}" disabled="{{saving || !editable}}" bindtap="known">
        <block wx:if="{{item.sources.length}}"><view wx:for="{{item.sources}}" wx:key="id" wx:for-item="source" class="ui-card vehicle-card"><aw-vehicle-label vehicle-id="{{source.id}}" name="{{source.name}}" catalog-revision="{{catalogRevision}}"/><view class="vehicle-card-note">研发前置</view></view><view wx:if="{{item.tokenText}}" class="muted route-note">{{item.tokenText}}</view></block>
        <view wx:else="" class="ui-card vehicle-card route-summary">{{item.name}}</view>
      </button>
      <view wx:if="{{!options.length}}" class="muted">暂无可选择的已知前置。</view>
      <view class="label">自定义前置</view><view wx:if="{{draft.mode === 'custom'}}" class="custom-tag">自定义前置</view><view wx:for="{{customNames}}" wx:key="id" class="ui-card vehicle-card"><aw-vehicle-label vehicle-id="{{item.id}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/></view><button style="width:100%;max-width:none;margin-left:0;margin-right:0" class="ui-button ghost" disabled="{{saving || !editable}}" bindtap="custom">{{draft.mode === 'custom' ? '编辑自定义前置' : '+ 自定义前置'}}</button>
      <block wx:if="{{providers.length}}"><view class="label">可提供 Token 的车辆 · 可多选</view><button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:for="{{providers}}" wx:key="id" class="ui-button ui-card vehicle-card {{item.selected ? 'active' : ''}}" data-id="{{item.vehicleId}}" disabled="{{saving || !editable}}" bindtap="provider"><view class="choice-heading"><aw-vehicle-label vehicle-id="{{item.vehicleId}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/><text class="selection-mark">{{item.selected ? '✓' : '+'}}</text></view><view class="vehicle-card-note">{{item.tokenName}} ×{{item.quantity == null ? '—' : item.quantity}}</view></button></block>
    </block>
    <block wx:else="">
      <button style="width:100%;max-width:none;margin-left:0;margin-right:0" class="ui-button ui-compact ghost small" disabled="{{saving}}" bindtap="back">‹ 返回已知前置</button><view class="ui-card vehicle-card muted note">仅用于当前玩家的规划；不会修改公共车辆数据。</view>
      <input class="ui-field search" placeholder="搜索所有车辆" value="{{query}}" bindinput="search" bindkeyboardheightchange="keyboard" adjust-position="{{false}}"/>
      <view class="label">已选 {{customNames.length}} 辆</view><button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:for="{{customNames}}" wx:key="id" class="ui-button ui-card vehicle-card active" data-id="{{item.id}}" disabled="{{saving}}" bindtap="toggleCustom"><view class="choice-heading"><aw-vehicle-label vehicle-id="{{item.id}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/><text class="selection-mark">×</text></view></button>
      <button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:for="{{candidates}}" wx:key="id" class="ui-button ui-card vehicle-card {{item.selected ? 'active' : ''}}" data-id="{{item.id}}" disabled="{{saving}}" bindtap="toggleCustom"><view class="choice-heading"><aw-vehicle-label vehicle-id="{{item.id}}" name="{{item.name}}" catalog-revision="{{catalogRevision}}"/><text class="selection-mark">{{item.selected ? '✓' : '+'}}</text></view></button>
      <button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:if="{{count > candidates.length}}" disabled="{{saving}}" bindtap="more" class="ui-button ghost">加载更多（{{candidates.length}} / {{count}}）</button>
    </block>
  </scroll-view>
  <view class="footer"><button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:if="{{stage === 'custom'}}" class="ui-button ghost" disabled="{{saving}}" bindtap="back">完成选择</button><button style="width:100%;max-width:none;margin-left:0;margin-right:0" wx:else="" class="ui-button primary" loading="{{saving}}" disabled="{{saving || !editable}}" bindtap="save">保存配置</button></view>
</view>
