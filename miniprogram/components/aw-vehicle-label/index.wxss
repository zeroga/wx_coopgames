/* Fixed badge columns: wrapping names never move the type or tier. */
.vehicle-label { display:flex; flex:1; align-items:flex-start; gap:10rpx; min-width:0; width:100%; box-sizing:border-box; text-align:left; color:#1c1a1e; line-height:1.45; }
.vehicle-badge { display:flex; align-items:center; justify-content:center; flex:none; height:44rpx; margin-top:1rpx; box-sizing:border-box; border:1rpx solid #dedbe0; border-radius:8rpx; background:#ece9ed; color:#514a58; font-size:21rpx; font-weight:700; line-height:1; }
.vehicle-class { width:68rpx; }
.vehicle-tier { width:64rpx; }
.vehicle-class-code { font-size:21rpx; }
.vehicle-name { flex:1; min-width:0; font-size:32rpx; font-weight:800; overflow-wrap:break-word; word-break:normal; }
.vehicle-label-hero { color:#fff; }
.vehicle-label-hero .vehicle-name { font-size:40rpx; }
.vehicle-label-hero .vehicle-badge { margin-top:7rpx; }
