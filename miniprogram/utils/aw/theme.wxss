page { background:#f1f0f2; color:#29252e; font-size:28rpx; }
.aw-page { padding:28rpx 26rpx 80rpx; }
.title { font-size:46rpx; font-weight:700; line-height:1.25; }
.subtitle,.muted { color:#756e7f; font-size:24rpx; line-height:1.6; }
.subtitle { margin:12rpx 0 24rpx; }
.nav,.tabs,.row,.actions { display:flex; align-items:center; gap:14rpx; flex-wrap:wrap; }
.nav { margin-bottom:26rpx; }
.nav button,.small { font-size:24rpx; padding:0 22rpx; margin:0; line-height:64rpx; }
button { font-size:28rpx; border-radius:14rpx; line-height:78rpx; }
button::after { border:0; }
button.primary,.nav button.active { color:white; background:#504060; }
button.ghost { color:#504060; background:#eee8f2; }
button.danger { color:#ae3656; background:#faedf0; }
.card { background:white; border:1rpx solid #e8e2ec; border-radius:22rpx; padding:28rpx; margin:20rpx 0; }
.card-title { font-weight:700; font-size:32rpx; }
.section-title { font-size:32rpx; font-weight:700; margin:30rpx 0 16rpx; }
.between { justify-content:space-between; }
.tag { display:inline-block; font-size:22rpx; padding:8rpx 14rpx; border-radius:10rpx; background:#eee8f2; color:#59446b; margin:6rpx 8rpx 6rpx 0; line-height:1.4; }
.tag.selected { background:#504060; color:white; }
.tag.warning,.warning { background:#fff4dd; color:#8e6321; }
.tag.ok { background:#e3f3ed; color:#286c55; }
.warning { border-radius:14rpx; padding:20rpx; font-size:24rpx; line-height:1.6; margin:18rpx 0; }
input,textarea,.picker { background:#f4f1f6; border:1rpx solid #e2dbe9; border-radius:12rpx; padding:20rpx; box-sizing:border-box; min-height:84rpx; font-size:28rpx; width:100%; }
textarea { height:150rpx; }
.label { font-size:24rpx; color:#756e7f; margin:20rpx 0 10rpx; }
.metrics { display:grid; grid-template-columns:1fr 1fr; gap:16rpx; margin:20rpx 0; }
.metric { border-radius:14rpx; background:#f7f4f9; padding:20rpx; }
.metric .value { font-size:34rpx; font-weight:700; margin-top:6rpx; }
.line { padding:16rpx 0; border-bottom:1rpx solid #eee8f2; line-height:1.6; }
.empty { text-align:center; color:#756e7f; padding:56rpx 22rpx; line-height:1.8; }
.link { color:#76538e; font-size:24rpx; padding:14rpx 0; }
.actions { margin-top:18rpx; }
.actions button { flex:1; margin:0; min-width:160rpx; }
.sticky { position:sticky; top:0; background:#f1f0f2; padding:12rpx 0; z-index:3; }
