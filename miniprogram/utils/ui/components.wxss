/* Shared component rules extracted from SnowRunner's app/game styles.
   Repeated class selectors intentionally beat native style-v2 button defaults. */
.ui-card.ui-card { background:#fbfafc; color:#1c1a1e; border:1rpx solid rgba(28,26,30,.12); border-radius:22rpx; box-shadow:0 8rpx 26rpx rgba(28,26,30,.05); box-sizing:border-box; }
.ui-card.selected { border-color:#ea7428; }
.ui-button.ui-button { display:flex; align-items:center; justify-content:center; box-sizing:border-box; width:100%; max-width:100%; min-width:0; min-height:44px; padding:16rpx 26rpx; margin:0; border:0; border-radius:14rpx; font-size:26rpx; font-weight:400; line-height:1.3; text-align:center; white-space:normal; }
.ui-button::after { border:0; }
.ui-button.primary,.ui-button.btn-primary { background:#1c1a1e; color:#fff; }
.ui-button.ghost,.ui-button.btn-ghost { background:#fff; color:#1c1a1e; border:1rpx solid rgba(28,26,30,.12); }
.ui-button.danger { background:#fff; color:#cf3a36; border:1rpx solid rgba(207,58,54,.2); }
.ui-button.ui-compact { width:auto; flex:none; padding:10rpx 18rpx; font-size:23rpx; }
.ui-button.choice { flex:1; width:auto; min-width:88rpx; background:#ece9ed; color:#6b6370; padding:10rpx 16rpx; border-radius:9rpx; font-size:23rpx; }
.ui-button.choice.active { background:#ea7428; color:#fff; font-weight:700; }
.ui-button.quiet-control,.ui-button.cancel-control { flex:none; width:auto; min-width:44px; padding:8rpx 12rpx; border:0; background:transparent; color:#6b6370; font-size:23rpx; }
.ui-button.quiet-control.danger { color:#cf3a36; }
.ui-button.cancel-control { white-space:nowrap; }
.ui-button.prerequisite-alert { flex:none; width:44px; min-width:44px; height:44px; padding:0; margin:0; border:0; background:transparent; }
.ui-button.vehicle-card { display:block; padding:25rpx; margin:18rpx 0; text-align:left; border:1rpx solid rgba(28,26,30,.12); border-radius:22rpx; background:#fbfafc; color:#1c1a1e; }
.ui-button.vehicle-card.active,.ui-button.vehicle-card.selected { border-color:#ea7428; background:#fff2df; }
.ui-button.vehicle-route { display:block; padding:0; margin:18rpx 0; border:0; background:transparent; text-align:left; }
.ui-button.route { text-align:left; }
.ui-button[disabled] { opacity:.45; }
.ui-tab.ui-tab { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:44px; min-width:0; padding:10rpx 16rpx; border-radius:12rpx; font-size:26rpx; font-weight:700; line-height:1.3; text-align:center; color:#6b6370; }
.ui-tab.active { background:#fff; color:#1c1a1e; box-shadow:0 3rpx 10rpx rgba(28,26,30,.08); }
/* The wrapper owns the tap; the visible face retains SnowRunner's compact segment style. */
.ui-option { display:inline-flex; align-items:center; justify-content:center; vertical-align:middle; box-sizing:border-box; min-height:44px; min-width:44px; max-width:100%; padding:4px 0; margin:0 12rpx 0 0; }
.ui-option-face { display:flex; align-items:center; justify-content:center; box-sizing:border-box; min-height:56rpx; min-width:56rpx; max-width:100%; padding:10rpx 17rpx; border-radius:9rpx; background:#ece9ed; color:#6b6370; font-size:26rpx; line-height:1.3; text-align:center; overflow-wrap:break-word; }
.ui-option.selected .ui-option-face,.ui-option.active .ui-option-face { background:#ea7428; color:#fff; font-weight:700; }
.ui-icon-touch { display:inline-flex; align-items:center; justify-content:center; flex:none; box-sizing:border-box; min-width:44px; min-height:44px; padding:0; }
.ui-tap-row { display:flex; align-items:center; min-height:44px; box-sizing:border-box; }
.ui-divider { border-bottom:1rpx dashed rgba(28,26,30,.12); }
.ui-field.ui-field { box-sizing:border-box; width:100%; height:88rpx; min-height:44px; padding:0 20rpx; border:0; border-radius:14rpx; background:#f1f0f2; color:#1c1a1e; font-size:26rpx; line-height:1.4; }
.ui-textarea.ui-textarea { box-sizing:border-box; width:100%; min-height:104rpx; padding:16rpx; border:0; border-radius:12rpx; background:#f2eff3; color:#514a55; font-size:23rpx; line-height:1.55; }
.ui-card.vehicle-warning { border-color:#e5c98f; background:#fff2df; }
.ui-button.archive-toggle { margin-top:16rpx; }
.ui-button.choice { min-height:44px; }
.ui-button.ui-compact.small { min-height:44px; }

.ui-option-grid,.tags { display:flex; flex-wrap:wrap; align-items:center; gap:0 12rpx; min-width:0; }
.ui-option-grid .ui-option,.tags .ui-option { flex:0 0 auto; margin:0; }
.actions,.cloud-actions,.add-season-actions,.segments { align-items:stretch; }
